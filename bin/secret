#!/usr/bin/env bash
#
# secret — unified secret rotate/set/pull across projects
# Reads configs from $SECRET_CONFIG_DIR (default ~/.config/keyrotate/<name>.json).
#
# Strategies:
#   atlas-mongodb : PATCH Atlas user password → assemble mongodb+srv://… URI
#   random        : openssl rand → base62 (default) or hex
#   manual        : value comes from --value / --from-stdin (set only, no rotate)
#
# Targets:
#   gcpSecretManager  cloudRun  vercel  koyeb  localEnv
#
# Usage:
#   secret ls
#   secret list <project>
#   secret rotate <project> <KEY>
#   secret set    <project> <KEY> [--value V | --from-stdin]
#   secret pull   <project> [KEY]
#
set -euo pipefail

CONFIG_DIR="${SECRET_CONFIG_DIR:-$HOME/.config/keyrotate}"
GCLOUD="${GCLOUD:-$HOME/Downloads/google-cloud-sdk/bin/gcloud}"
ATLAS_API_VERSION="${ATLAS_API_VERSION:-2024-08-05}"

need() { command -v "$1" >/dev/null 2>&1 || { echo "❌ $1 required" >&2; exit 1; }; }
need jq; need curl; need openssl
[ -x "$GCLOUD" ] || GCLOUD="$(command -v gcloud || true)"

usage() {
  cat <<'EOF' >&2
secret ls                                       list known projects
secret list           <project>                 list secrets in a project config
secret rotate         <project> <KEY>           rotate (atlas-mongodb / random)
secret set            <project> <KEY> [--value V | --from-stdin]
secret add            <project> <KEY> --value V [--separator ,]  append item to a delimited list value (read+dedupe+push)
secret remove         <project> <KEY> --value V [--separator ,]  remove item from a delimited list value
secret pull           <project> [KEY]           resync localEnv from GCP Secret Manager
secret vercel-upgrade <project|--all> [--dry-run] [--encrypted|--sensitive] [--all-keys]
                                                upgrade Vercel env vars (plain → sensitive, encrypted → sensitive in-place).
                                                By default only credential-shaped names get upgraded
                                                (*_SECRET, *_TOKEN, *_KEY, *_PASSWORD, *_PRIVATE, *_CREDENTIALS, MONGODB_URI, …).
                                                --all-keys overrides the heuristic and upgrades every var.
                                                --all iterates every config that declares a vercel block.
secret notes          [project [KEY]]           show rotation playbooks. no args = every secret with manualSteps across all
                                                projects; one arg = all in that project; two args = that one secret.
EOF
}

CFG=""
cfg()     { jq -r "$1 // empty" "$CFG"; }
cfg_arr() { jq -r "$1 // empty | .[]?" "$CFG"; }
cfg_root(){ jq -r '.projectRoot' "$CFG"; }
lc()      { tr '[:upper:]' '[:lower:]'; }

resolve_project() {
  local q="$1" f name aliased
  # 1. alias map
  if [ -f "$CONFIG_DIR/_aliases.json" ]; then
    aliased=$(jq -r --arg q "$q" '.[$q] // empty' "$CONFIG_DIR/_aliases.json")
    [ -n "$aliased" ] && q="$aliased"
  fi
  # 2. exact name
  f="$CONFIG_DIR/$q.json"; [ -f "$f" ] && { echo "$f"; return 0; }
  # 3. case-insensitive prefix match
  local qlc; qlc=$(printf '%s' "$q" | lc)
  local hits="" hitcount=0
  for f in "$CONFIG_DIR"/*.json; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .json)
    [ "$name" = "_aliases" ] && continue
    local nlc; nlc=$(printf '%s' "$name" | lc)
    case "$nlc" in "$qlc"*) hits="$hits $f"; hitcount=$((hitcount+1));; esac
  done
  case "$hitcount" in
    0) echo "❌ no project matches '$q' in $CONFIG_DIR" >&2; return 1 ;;
    1) echo "${hits# }" ;;
    *) echo "❌ ambiguous '$q':" >&2
       for f in $hits; do echo "    $(basename "$f" .json)" >&2; done
       return 1 ;;
  esac
}

# ────────────────────────── value generation ──────────────────────────

gen_random() {
  local length="$1" encoding="${2:-base62}"
  case "$encoding" in
    hex)    openssl rand -hex "$length" | head -c "$length" ;;
    base62) openssl rand -base64 $((length*2)) | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c "$length" ;;
    *) echo "❌ unknown encoding $encoding" >&2; return 1 ;;
  esac
}

gen_atlas_mongodb() {
  local key="$1"
  local pid;   pid=$(cfg ".secrets[\"$key\"].atlas.projectId")
  local user;  user=$(cfg ".secrets[\"$key\"].atlas.dbUser")
  local authdb;authdb=$(cfg ".secrets[\"$key\"].atlas.authDb")
  local host;  host=$(cfg ".secrets[\"$key\"].atlas.clusterHost")
  local params;params=$(cfg ".secrets[\"$key\"].atlas.uriParams")
  local dbname;dbname=$(cfg ".secrets[\"$key\"].atlas.dbName")   # optional; embeds /<dbname> in URI path
  local ksvc;  ksvc=$(cfg '.atlasKeychainService'); ksvc="${ksvc:-atlas-api}"

  for v in pid user authdb host params; do
    eval "[ -n \"\${$v}\" ]" || { echo "❌ atlas.$v missing for $key" >&2; return 1; }
  done

  local pub priv
  pub=$(security find-generic-password -s "$ksvc" -a public  -w 2>/dev/null) \
    || { echo "❌ atlas keychain '$ksvc' missing" >&2; return 1; }
  priv=$(security find-generic-password -s "$ksvc" -a private -w 2>/dev/null) \
    || { echo "❌ atlas keychain '$ksvc' missing private key" >&2; return 1; }

  local new_pw; new_pw=$(openssl rand -base64 60 | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 40)
  [ "${#new_pw}" -ge 32 ] || { echo "❌ pw too short" >&2; return 1; }

  echo "🌐 PATCH Atlas user '$user' (project $pid)…" >&2
  local code tmp; tmp="$(mktemp)"
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    --user "$pub:$priv" --digest -X PATCH \
    "https://cloud.mongodb.com/api/atlas/v2/groups/$pid/databaseUsers/$authdb/$user" \
    -H "Accept: application/vnd.atlas.$ATLAS_API_VERSION+json" \
    -H "Content-Type: application/vnd.atlas.$ATLAS_API_VERSION+json" \
    -d "$(jq -nc --arg p "$new_pw" '{password:$p}')")
  if [ "$code" != "200" ]; then
    echo "❌ Atlas HTTP $code" >&2; cat "$tmp" >&2; rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"
  echo "✅ Atlas password rotated" >&2
  # Build URI. If atlas.dbName is set, embed it in the path so consumers that
  # parse the db name from the URI (e.g. mongodump in CI backup workflows) work.
  if [ -n "$dbname" ]; then
    printf 'mongodb+srv://%s:%s@%s/%s?%s' "$user" "$new_pw" "$host" "$dbname" "$params"
  else
    printf 'mongodb+srv://%s:%s@%s/?%s' "$user" "$new_pw" "$host" "$params"
  fi
}

# ────────────────────────── propagation ──────────────────────────

gcp_secret_name() {
  local key="$1" explicit
  explicit=$(cfg ".secrets[\"$key\"].gcpSecretName")
  if [ -n "$explicit" ]; then printf '%s' "$explicit"
  else printf '%s' "$key" | lc | tr '_' '-'
  fi
}

prop_gcp_secret_manager() {
  local key="$1" value="$2"
  local proj acct name
  proj=$(cfg .gcpProject); [ -n "$proj" ] || { echo "❌ no gcpProject" >&2; return 1; }
  acct=$(cfg .gcpAccount)
  name=$(gcp_secret_name "$key")
  local gargs; gargs="--project $proj"
  [ -n "$acct" ] && gargs="$gargs --account $acct"

  if ! $GCLOUD secrets describe "$name" $gargs >/dev/null 2>&1; then
    echo "  → creating GCP secret '$name'…" >&2
    $GCLOUD secrets create "$name" $gargs --replication-policy=automatic
  fi
  printf '%s' "$value" | $GCLOUD secrets versions add "$name" $gargs --data-file=- >/dev/null
  echo "  ✅ gcpSecretManager: $name updated" >&2
}

prop_cloud_run() {
  local key="$1" _v="$2"
  local proj acct region name
  proj=$(cfg .gcpProject);   [ -n "$proj" ] || { echo "❌ cloudRun needs gcpProject" >&2; return 1; }
  acct=$(cfg .gcpAccount)
  region=$(cfg '.cloudRun.region')
  name=$(gcp_secret_name "$key")
  local gargs; gargs="--project $proj --region $region"
  [ -n "$acct" ] && gargs="$gargs --account $acct"

  local svc
  cfg_arr '.cloudRun.services' | while IFS= read -r svc; do
    [ -n "$svc" ] || continue
    # drop any plain env var with same name first; harmless if it doesn't exist
    $GCLOUD run services update "$svc" $gargs --remove-env-vars "$key" >/dev/null 2>&1 || true
    $GCLOUD run services update "$svc" $gargs --update-secrets "$key=$name:latest" >/dev/null
    echo "  ✅ cloudRun: $svc ← $key=$name:latest" >&2
  done
}

prop_vercel() {
  local key="$1" value="$2"
  local pid org token tmp
  pid=$(cfg '.vercel.projectId'); [ -n "$pid" ] || { echo "❌ no vercel.projectId" >&2; return 1; }
  org=$(cfg '.vercel.orgId')
  token=$(security find-generic-password -s vercel-api -a token -w 2>/dev/null || true)
  [ -n "$token" ] || token="${VERCEL_TOKEN:-}"
  [ -n "$token" ] || { echo "❌ need vercel token in keychain 'vercel-api' (or \$VERCEL_TOKEN)" >&2; return 1; }

  local team_qs=""; [ -n "$org" ] && team_qs="?teamId=$org"
  tmp="$(mktemp)"
  curl -sS -H "Authorization: Bearer $token" \
    "https://api.vercel.com/v10/projects/$pid/env$team_qs" >"$tmp"

  local env
  cfg_arr '.vercel.envs' | while IFS= read -r env; do
    [ -n "$env" ] || continue
    # Vercel rule: sensitive type cannot target 'development'. Skip dev silently
    # (local dev gets the value via .env / localEnv target anyway).
    if [ "$env" = "development" ]; then
      echo "  ↷ vercel: skip $key on development (sensitive type can't target it)" >&2
      continue
    fi
    # delete any existing entry for this key+env
    jq -r --arg k "$key" --arg e "$env" \
      '.envs[]? | select(.key==$k and (.target | index($e))) | .id' "$tmp" \
    | while IFS= read -r id; do
        [ -n "$id" ] || continue
        curl -sS -X DELETE -H "Authorization: Bearer $token" \
          "https://api.vercel.com/v10/projects/$pid/env/$id$team_qs" >/dev/null
      done
    # create as sensitive
    local code; local out; out="$(mktemp)"
    code=$(curl -sS -o "$out" -w '%{http_code}' -X POST \
      -H "Authorization: Bearer $token" \
      -H "Content-Type: application/json" \
      "https://api.vercel.com/v10/projects/$pid/env$team_qs" \
      -d "$(jq -nc --arg k "$key" --arg v "$value" --arg t "$env" \
              '{key:$k, value:$v, type:"sensitive", target:[$t]}')")
    if ! echo "$code" | grep -qE '^20'; then
      echo "  ❌ vercel($env) HTTP $code"; cat "$out"; rm -f "$out" "$tmp"; return 1
    fi
    rm -f "$out"
    echo "  ✅ vercel: $key on $env (sensitive)" >&2
  done
  rm -f "$tmp"
}

prop_koyeb() {
  local key="$1" value="$2"
  local ksvc; ksvc=$(cfg '.koyeb.tokenKeychainService'); ksvc="${ksvc:-koyeb-api}"
  local token
  token=$(security find-generic-password -s "$ksvc" -a token -w 2>/dev/null || true)
  [ -n "$token" ] || token="${KOYEB_TOKEN:-}"
  [ -n "$token" ] || { echo "❌ need koyeb token in keychain '$ksvc' (or \$KOYEB_TOKEN)" >&2; return 1; }
  local svc_name; svc_name=$(cfg '.koyeb.serviceName')

  # Account-level secret upsert: try update, fall back to delete+create.
  local tmp code; tmp="$(mktemp)"
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    -X PUT "https://app.koyeb.com/v1/secrets/$key" \
    -d "$(jq -nc --arg v "$value" '{type:"SIMPLE", value:$v}')")
  if ! echo "$code" | grep -qE '^20'; then
    curl -sS -X DELETE -H "Authorization: Bearer $token" \
      "https://app.koyeb.com/v1/secrets/$key" >/dev/null 2>&1 || true
    code=$(curl -sS -o "$tmp" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      -X POST "https://app.koyeb.com/v1/secrets" \
      -d "$(jq -nc --arg n "$key" --arg v "$value" '{name:$n, type:"SIMPLE", value:$v}')")
  fi
  if ! echo "$code" | grep -qE '^20'; then
    echo "  ❌ koyeb HTTP $code"; cat "$tmp"; rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"
  echo "  ✅ koyeb: $key upserted (service '$svc_name' needs redeploy to pick it up)" >&2
}

prop_user_password() {
  # Composite target: bcrypt+write to auth-backend Mongo AND push plaintext to a
  # set of GitHub Actions repos. Used for the test-user password rotation case
  # where the two sinks need the same secret in different forms.
  local key="$1" value="$2"
  command -v node >/dev/null 2>&1 || { echo "❌ node required for userPassword target" >&2; return 1; }
  command -v gh   >/dev/null 2>&1 || { echo "❌ gh CLI required for userPassword target" >&2; return 1; }

  local up_json
  up_json=$(jq -c --arg k "$key" '.secrets[$k].userPassword // empty' "$CFG")
  [ -n "$up_json" ] || { echo "❌ secrets[$key].userPassword block missing" >&2; return 1; }

  local proj_ref username db_name collection rounds
  proj_ref=$(echo "$up_json"   | jq -r '.projectRef // empty')
  username=$(echo "$up_json"   | jq -r '.username // empty')
  db_name=$(echo "$up_json"    | jq -r '.dbName // empty')
  collection=$(echo "$up_json" | jq -r '.collection // empty')
  rounds=$(echo "$up_json"     | jq -r '.bcryptRounds // empty')
  [ -n "$proj_ref" ] || { echo "❌ userPassword.projectRef missing" >&2; return 1; }
  [ -n "$username" ] || { echo "❌ userPassword.username missing" >&2; return 1; }

  # Resolve projectRef → its config → first localEnv file → read MONGODB_URI
  local ref_cfg ref_root env_file env_path mongo_uri
  ref_cfg=$(resolve_project "$proj_ref") || return 1
  ref_root=$(jq -r '.projectRoot' "$ref_cfg")
  env_file=$(jq -r '.localEnv[0].file // empty' "$ref_cfg")
  [ -n "$env_file" ] || { echo "❌ projectRef '$proj_ref' has no localEnv to read MONGODB_URI from" >&2; return 1; }
  env_path="$ref_root/$env_file"
  if [ ! -f "$env_path" ]; then
    echo "❌ $env_path doesn't exist — run \`secret rotate $proj_ref MONGODB_URI\` first to populate it" >&2
    return 1
  fi
  mongo_uri=$(grep -E '^MONGODB_URI=' "$env_path" | head -1 | cut -d= -f2-)
  [ -n "$mongo_uri" ] || { echo "❌ MONGODB_URI not found in $env_path" >&2; return 1; }

  # If config didn't pin dbName, read it from the same .env (auth backend's source of truth).
  if [ -z "$db_name" ]; then
    db_name=$(grep -E '^DB_NAME=' "$env_path" | head -1 | cut -d= -f2-)
  fi

  # 1. Update Mongo user document via node helper
  local helper="$HOME/bin/secret-helpers/user-password.mjs"
  [ -f "$helper" ] || { echo "❌ helper missing at $helper" >&2; return 1; }
  local out
  if ! out=$(MONGODB_URI="$mongo_uri" USERNAME="$username" PASSWORD="$value" \
              DB_NAME="${db_name:-app_users}" \
              COLLECTION="${collection:-users}" \
              BCRYPT_ROUNDS="${rounds:-12}" \
              node "$helper" 2>&1); then
    echo "  ❌ userPassword: mongo write failed" >&2
    printf '%s\n' "$out" | sed 's/^/      /' >&2
    return 1
  fi
  echo "  ✅ userPassword: bcrypt'd & wrote to ${db_name:-app_users}.${collection:-users} for username='$username' ($out)" >&2

  # 2. Push plaintext to GitHub repos listed under userPassword.githubRepos
  local repos
  repos=$(echo "$up_json" | jq -r '.githubRepos[]? // empty')
  if [ -z "$repos" ]; then
    echo "  ℹ️  no .githubRepos under userPassword — skipping plaintext push" >&2
    return 0
  fi
  printf '%s\n' "$repos" | while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    if printf '%s' "$value" | gh secret set "$key" --repo "$repo" >/dev/null 2>&1; then
      echo "  ✅ userPassword: plaintext → $repo" >&2
    else
      echo "  ❌ userPassword: gh secret set failed for $repo" >&2
      return 1
    fi
  done
}

prop_github() {
  local key="$1" value="$2"
  command -v gh >/dev/null 2>&1 || { echo "❌ gh CLI required for github target (brew install gh)" >&2; return 1; }
  # Precedence:
  #   1. .secrets[KEY].github.repos  (per-secret override)
  #   2. .secrets[KEY].github.repo
  #   3. .github.repos / .github.repo (top-level default)
  local repos=""
  local per_repos per_repo top_repos top_repo
  per_repos=$(jq -r --arg k "$key" '.secrets[$k].github.repos[]?' "$CFG")
  per_repo=$(jq -r  --arg k "$key" '.secrets[$k].github.repo  // empty' "$CFG")
  if [ -n "$per_repos" ] || [ -n "$per_repo" ]; then
    repos="$per_repos"
    [ -n "$per_repo" ] && repos="$repos
$per_repo"
  else
    top_repos=$(jq -r '.github.repos[]?' "$CFG")
    top_repo=$(cfg '.github.repo')
    repos="$top_repos"
    [ -n "$top_repo" ] && repos="$repos
$top_repo"
  fi
  repos=$(printf '%s\n' "$repos" | sed '/^$/d' | sort -u)
  [ -n "$repos" ] || { echo "❌ no .github.repo / .github.repos for $key" >&2; return 1; }
  printf '%s\n' "$repos" | while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    if printf '%s' "$value" | gh secret set "$key" --repo "$repo" >/dev/null 2>&1; then
      echo "  ✅ github: $key on $repo" >&2
    else
      echo "  ❌ github: failed to set $key on $repo" >&2
      return 1
    fi
  done
}

prop_local_env() {
  local key="$1" value="$2"
  local root has_override targets_json
  root=$(cfg_root)
  has_override=$(jq -r --arg k "$key" '.secrets[$k] | has("localEnv")' "$CFG")
  if [ "$has_override" = "true" ]; then
    targets_json=$(jq -c --arg k "$key" '.secrets[$k].localEnv' "$CFG")
  else
    targets_json=$(jq -c '.localEnv // []' "$CFG")
  fi
  echo "$targets_json" | jq -c '.[]?' | while IFS= read -r entry; do
    local file env_key abs tmp
    file=$(echo "$entry" | jq -r '.file')
    env_key=$(echo "$entry" | jq -r --arg k "$key" '.key // $k')
    abs="$root/$file"
    mkdir -p "$(dirname "$abs")"
    touch "$abs"
    tmp="$(mktemp)"
    grep -v -E "^${env_key}=" "$abs" >"$tmp" || true
    printf '%s=%s\n' "$env_key" "$value" >>"$tmp"
    mv "$tmp" "$abs"
    chmod 600 "$abs"
    echo "  ✅ localEnv: $file ($env_key)" >&2
  done
}

propagate_all() {
  local key="$1" value="$2" t
  cfg_arr ".secrets[\"$key\"].targets" | while IFS= read -r t; do
    [ -n "$t" ] || continue
    case "$t" in
      gcpSecretManager) prop_gcp_secret_manager "$key" "$value" ;;
      cloudRun)         prop_cloud_run "$key" "$value" ;;
      vercel)           prop_vercel "$key" "$value" ;;
      koyeb)            prop_koyeb "$key" "$value" ;;
      github)           prop_github "$key" "$value" ;;
      userPassword)     prop_user_password "$key" "$value" ;;
      localEnv)         prop_local_env "$key" "$value" ;;
      *) echo "  ⚠️  unknown target '$t'" >&2 ;;
    esac
  done
}

# ────────────────────────── subcommands ──────────────────────────

cmd_ls() {
  local alias_file="$CONFIG_DIR/_aliases.json"
  echo "Projects (run with: secret <cmd> <name>)"
  echo
  local f n aliases nsec targets
  for f in "$CONFIG_DIR"/*.json; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .json)
    [ "$n" = "_aliases" ] && continue
    # aliases pointing to this canonical name, joined "a, b"
    if [ -f "$alias_file" ]; then
      aliases=$(jq -r --arg n "$n" \
        'to_entries | map(select(.value==$n) | .key) | join(", ")' "$alias_file")
    else
      aliases=""
    fi
    nsec=$(jq -r '.secrets | length' "$f")
    # union of all targets across secrets, ordered: gcpSM, cloudRun, vercel, koyeb, localEnv
    targets=$(jq -r '
      [.secrets[].targets[]?] | unique
      | map(
          if   . == "gcpSecretManager" then "gcpSM"
          elif . == "cloudRun"         then "cloudRun"
          elif . == "vercel"           then "vercel"
          elif . == "koyeb"            then "koyeb"
          elif . == "github"           then "github"
          elif . == "userPassword"     then "userPwd"
          elif . == "localEnv"         then "localEnv"
          else . end
        )
      | sort_by(
          { "gcpSM":0, "cloudRun":1, "vercel":2, "koyeb":3, "github":4, "userPwd":5, "localEnv":6 }[.]  // 9
        )
      | join(",")' "$f")
    local alias_disp="[$aliases]"
    printf "  %-18s %-14s  %2d secrets  → %s\n" \
      "$n" "$alias_disp" "$nsec" "$targets"
  done
  echo
  echo "Subcommands: list <p> | rotate <p> <KEY> | set <p> <KEY> [--value V|--from-stdin] | pull <p> [KEY]"
}

cmd_list() {
  CFG=$(resolve_project "$1") || exit 1
  echo "Project: $(basename "$CFG" .json)"
  echo "Config:  $CFG"
  echo
  jq -r '
    .secrets | to_entries[]
    | "  \(.key)\t[\(.value.strategy)]\t→ \(.value.targets | join(","))\t\(if (.value.manualSteps // [] | length) > 0 then "📝" else "" end)"
  ' "$CFG" | column -t -s$'\t'
  if jq -e '.secrets | to_entries[] | select((.value.manualSteps // [] | length) > 0)' "$CFG" >/dev/null 2>&1; then
    echo
    echo "📝 = has rotation playbook. Show with: secret notes $(basename "$CFG" .json) <KEY>"
  fi
}

cmd_rotate() {
  CFG=$(resolve_project "$1") || exit 1
  local key="$2"
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; exit 1; }

  local value=""
  case "$strategy" in
    atlas-mongodb)
      value=$(gen_atlas_mongodb "$key") ;;
    random)
      local length encoding
      length=$(cfg ".secrets[\"$key\"].length");   length="${length:-48}"
      encoding=$(cfg ".secrets[\"$key\"].encoding"); encoding="${encoding:-base62}"
      value=$(gen_random "$length" "$encoding")
      echo "🔑 generated $length-char $encoding random for $key" >&2 ;;
    manual)
      echo "❌ '$key' is strategy=manual — use 'secret set' instead" >&2; exit 1 ;;
    *) echo "❌ unknown strategy '$strategy'" >&2; exit 1 ;;
  esac
  [ -n "$value" ] || { echo "❌ no value generated" >&2; exit 1; }
  propagate_all "$key" "$value"
  echo "🎉 rotated $key"
}

cmd_set() {
  CFG=$(resolve_project "$1") || exit 1
  local key="$2"; shift 2
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; exit 1; }
  local value=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --value)      value="$2"; shift 2 ;;
      --from-stdin) value="$(cat)"; shift ;;
      *) echo "❌ unknown arg '$1'" >&2; exit 1 ;;
    esac
  done
  if [ -z "$value" ]; then
    printf "Value for %s: " "$key" >&2
    stty -echo 2>/dev/null; IFS= read -r value; stty echo 2>/dev/null; echo >&2
  fi
  [ -n "$value" ] || { echo "❌ empty value" >&2; exit 1; }
  propagate_all "$key" "$value"
  echo "🎉 set $key"
}

# Read the current value of $key for the resolved CFG. Tries sources in
# decreasing reliability:
#   1. localEnv file (cheapest, no API)
#   2. GCP Secret Manager (latest version)
#   3. Vercel single-env endpoint with decrypt=true (works for plain/encrypted,
#      NOT sensitive)
# Used by add/remove to know existing list values before mutating them.
_read_current_value() {
  local key="$1"
  local got=""

  # ── 1. localEnv ─────────────────────────────────────────────────────
  local root env_file env_path
  root=$(cfg_root)
  if [ -n "$root" ]; then
    env_file=$(jq -r --arg k "$key" '.secrets[$k].localEnv[0].file // empty' "$CFG")
    [ -z "$env_file" ] && env_file=$(jq -r '.localEnv[0].file // empty' "$CFG")
    if [ -n "$env_file" ] && [ -f "$root/$env_file" ]; then
      got=$(grep -E "^${key}=" "$root/$env_file" | head -1 | cut -d= -f2-)
      if [ -n "$got" ]; then printf '%s' "$got"; return 0; fi
    fi
  fi

  # ── 2. GCP Secret Manager ──────────────────────────────────────────
  local proj acct name
  proj=$(cfg .gcpProject)
  if [ -n "$proj" ]; then
    local has_target
    has_target=$(jq -r --arg k "$key" '.secrets[$k].targets | index("gcpSecretManager") // empty' "$CFG")
    if [ -n "$has_target" ]; then
      acct=$(cfg .gcpAccount)
      name=$(gcp_secret_name "$key")
      local gargs="--project $proj"
      [ -n "$acct" ] && gargs="$gargs --account $acct"
      got=$($GCLOUD secrets versions access latest --secret "$name" $gargs 2>/dev/null || true)
      if [ -n "$got" ]; then printf '%s' "$got"; return 0; fi
    fi
  fi

  # ── 3. Vercel single-env endpoint ──────────────────────────────────
  local pid org
  pid=$(cfg '.vercel.projectId')
  if [ -n "$pid" ]; then
    org=$(cfg '.vercel.orgId')
    local token
    token=$(security find-generic-password -s vercel-api -a token -w 2>/dev/null || true)
    [ -z "$token" ] && token="${VERCEL_TOKEN:-}"
    if [ -n "$token" ]; then
      local team_qs=""; [ -n "$org" ] && team_qs="?teamId=$org"
      local list; list=$(curl -sS -H "Authorization: Bearer $token" \
        "https://api.vercel.com/v10/projects/$pid/env$team_qs")
      local env_id; env_id=$(echo "$list" | jq -r --arg k "$key" \
        '.envs[] | select(.key==$k) | .id' | head -1)
      local env_type; env_type=$(echo "$list" | jq -r --arg k "$key" \
        '.envs[] | select(.key==$k) | .type' | head -1)
      if [ -n "$env_id" ] && [ "$env_type" != "sensitive" ]; then
        local one_url
        if [ -n "$org" ]; then
          one_url="https://api.vercel.com/v1/projects/$pid/env/$env_id?teamId=$org&decrypt=true"
        else
          one_url="https://api.vercel.com/v1/projects/$pid/env/$env_id?decrypt=true"
        fi
        local single; single=$(curl -sS -H "Authorization: Bearer $token" "$one_url")
        local decrypted; decrypted=$(echo "$single" | jq -r '.decrypted // false')
        if [ "$decrypted" = "true" ]; then
          got=$(echo "$single" | jq -r '.value')
          if [ -n "$got" ]; then
            echo "  ℹ️  read current value from Vercel (encrypted env, decrypted via single-env endpoint)" >&2
            printf '%s' "$got"; return 0
          fi
        elif [ "$env_type" = "sensitive" ]; then
          echo "  ⚠️  $key is type=sensitive on Vercel — value is write-only and can't be auto-read" >&2
        fi
      fi
    fi
  fi

  echo "❌ couldn't read current value of $key from any source (localEnv/gcpSM/vercel). Run \`secret set\` once to bootstrap." >&2
  return 1
}

cmd_add() {
  CFG=$(resolve_project "$1") || exit 1
  local key="$2"; shift 2
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; exit 1; }
  local new_item="" sep=","
  while [ $# -gt 0 ]; do
    case "$1" in
      --value)     new_item="$2"; shift 2 ;;
      --separator) sep="$2"; shift 2 ;;
      *) echo "❌ unknown arg '$1'" >&2; exit 1 ;;
    esac
  done
  [ -n "$new_item" ] || { echo "❌ --value required" >&2; exit 1; }

  local current; current=$(_read_current_value "$key") || exit 1

  # Dedupe: bail early if new_item already present.
  local IFS_save="$IFS"
  IFS="$sep"
  local found=0 item
  for item in $current; do
    [ "$item" = "$new_item" ] && { found=1; break; }
  done
  IFS="$IFS_save"
  if [ "$found" = "1" ]; then
    echo "✅ '$new_item' already in $key — no-op"
    return 0
  fi

  local new_value
  if [ -z "$current" ]; then new_value="$new_item"
  else new_value="${current}${sep}${new_item}"
  fi
  echo "🔧 $key: appending '$new_item' (separator='$sep')" >&2
  propagate_all "$key" "$new_value"
  echo "🎉 added '$new_item' to $key"
}

cmd_remove() {
  CFG=$(resolve_project "$1") || exit 1
  local key="$2"; shift 2
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; exit 1; }
  local drop_item="" sep=","
  while [ $# -gt 0 ]; do
    case "$1" in
      --value)     drop_item="$2"; shift 2 ;;
      --separator) sep="$2"; shift 2 ;;
      *) echo "❌ unknown arg '$1'" >&2; exit 1 ;;
    esac
  done
  [ -n "$drop_item" ] || { echo "❌ --value required" >&2; exit 1; }

  local current; current=$(_read_current_value "$key") || exit 1

  local IFS_save="$IFS"
  IFS="$sep"
  local kept="" found=0 item
  for item in $current; do
    if [ "$item" = "$drop_item" ]; then
      found=1
    else
      kept="${kept:+${kept}${sep}}${item}"
    fi
  done
  IFS="$IFS_save"
  if [ "$found" = "0" ]; then
    echo "✅ '$drop_item' not in $key — no-op"
    return 0
  fi
  echo "🔧 $key: removing '$drop_item' (separator='$sep')" >&2
  propagate_all "$key" "$kept"
  echo "🎉 removed '$drop_item' from $key"
}

_looks_secretly_named() {
  # Heuristic: returns 0 (true) when KEY name suggests a credential.
  local k="$1"
  case "$k" in
    MONGODB_URI|MONGO_URI|DATABASE_URL) return 0 ;;
    *_SECRET|SECRET_*|*_SECRET_*) return 0 ;;
    *_TOKEN|*_TOKEN_*) return 0 ;;
    *_PASSWORD|*_PASSWORD_*) return 0 ;;
    *_PRIVATE_KEY|*_PRIVATE) return 0 ;;
    *_API_KEY|*_API_SECRET) return 0 ;;
    *_CREDENTIALS|*_CREDENTIALS_*|*_CREDS) return 0 ;;
    *_KEY) return 0 ;;
  esac
  return 1
}

_vercel_upgrade_one() {
  # Requires CFG set. Args: dry(0|1), target_type(sensitive|encrypted), all_keys(0|1)
  # If $SECRET_SUMMARY_FILE is set, appends "name|up|skip|fail" for the wrapper.
  local dry="$1" target_type="$2" all_keys="${3:-0}"
  local _proj_name; _proj_name=$(basename "$CFG" .json)
  local _n_up=0 _n_sk=0 _n_fail=0
  local pid org token
  pid=$(cfg '.vercel.projectId'); [ -n "$pid" ] || { echo "❌ no vercel.projectId in $(basename "$CFG")" >&2; exit 1; }
  org=$(cfg '.vercel.orgId')
  token=$(security find-generic-password -s vercel-api -a token -w 2>/dev/null || true)
  [ -n "$token" ] || token="${VERCEL_TOKEN:-}"
  [ -n "$token" ] || { echo "❌ need vercel token in keychain 'vercel-api' (or \$VERCEL_TOKEN)" >&2; exit 1; }

  local team_arg=""; [ -n "$org" ] && team_arg="teamId=$org&"
  local tmp; tmp="$(mktemp)"
  curl -sS -H "Authorization: Bearer $token" \
    "https://api.vercel.com/v10/projects/$pid/env?${team_arg}decrypt=true" >"$tmp"

  local total plain enc
  total=$(jq -r '.envs | length' "$tmp")
  plain=$(jq -r '[.envs[] | select(.type=="plain")] | length' "$tmp")
  enc=$(jq -r '[.envs[] | select(.type=="encrypted")] | length' "$tmp")
  local heuristic_msg=""
  [ "$all_keys" = "0" ] && heuristic_msg=" (heuristic — *_SECRET/_TOKEN/_KEY/_PASSWORD/_PRIVATE/_CREDENTIALS/MONGODB_URI…)"
  echo "Project $(basename "$CFG" .json): $total env vars  ($plain plain, $enc encrypted, target=$target_type)$heuristic_msg"
  if [ "$plain" = "0" ] && { [ "$target_type" = "encrypted" ] || [ "$enc" = "0" ]; }; then
    rm -f "$tmp"; echo "✅ nothing to do"; return 0
  fi

  if [ "$dry" = "1" ]; then
    echo "── dry-run ──"
    # Build a unified, key-deduped list: per key, union of types + union of targets.
    local agg
    agg=$(jq -c '
      [.envs[] | select(.type=="plain" or .type=="encrypted") | {key, type, target}]
      | group_by(.key)
      | map({
          key:     .[0].key,
          types:   ([.[].type] | unique),
          targets: ([.[].target[]] | unique)
        })
      | sort_by(.key)
    ' "$tmp")

    local upgrade_list="" skip_list=""
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      local k tgts types
      k=$(echo "$row"     | jq -r '.key')
      tgts=$(echo "$row"  | jq -r '.targets | join(",")')
      types=$(echo "$row" | jq -r '.types | join("+")')
      if [ "$all_keys" = "1" ] || _looks_secretly_named "$k"; then
        upgrade_list+=$(printf '    ✓ %-40s  %-12s  targets=%s\n' "$k" "[$types]" "$tgts")$'\n'
      else
        skip_list+=$(printf '    ↷ %-40s  %-12s  targets=%s\n' "$k" "[$types]" "$tgts")$'\n'
      fi
    done < <(echo "$agg" | jq -c '.[]')

    local n_up n_sk
    n_up=$(printf '%s' "$upgrade_list" | grep -c . || true)
    n_sk=$(printf '%s' "$skip_list"    | grep -c . || true)
    _n_up="$n_up"; _n_sk="$n_sk"

    if [ "$n_up" -gt 0 ]; then
      echo
      echo "  ✓ will upgrade ($n_up keys) → $target_type:"
      printf '%s' "$upgrade_list"
    fi
    if [ "$n_sk" -gt 0 ]; then
      echo
      echo "  ↷ will skip ($n_sk keys) — name doesn't look credential-shaped:"
      printf '%s' "$skip_list"
    fi
    [ "$n_up" = 0 ] && [ "$n_sk" = 0 ] && echo "  (nothing in scope)"
    rm -f "$tmp"
    [ -n "${SECRET_SUMMARY_FILE:-}" ] && \
      echo "$_proj_name|$_n_up|$_n_sk|0" >> "$SECRET_SUMMARY_FILE"
    return 0
  fi

  local _tally; _tally=$(mktemp)

  # Path A: plain → target_type (need to read+rewrite value)
  if [ "$plain" != "0" ]; then
    echo "── plain → $target_type (delete + recreate) ──"
    jq -c '.envs[] | select(.type=="plain")' "$tmp" | while IFS= read -r entry; do
      local id key value targets_json
      id=$(echo "$entry"      | jq -r '.id')
      key=$(echo "$entry"     | jq -r '.key')
      value=$(echo "$entry"   | jq -r '.value')
      targets_json=$(echo "$entry" | jq -c '.target')
      if [ "$all_keys" = "0" ] && ! _looks_secretly_named "$key"; then
        echo "  ↷ $key  (skip — not credential-shaped)"
        echo sk >> "$_tally"
        continue
      fi
      # If target=sensitive, strip 'development'
      if [ "$target_type" = "sensitive" ]; then
        targets_json=$(echo "$targets_json" | jq -c 'map(select(. != "development"))')
        [ "$(echo "$targets_json" | jq 'length')" -gt 0 ] || {
          echo "  ⚠️  $key: only targets development — can't be sensitive, skipping"; continue
        }
      fi
      local dcode; dcode=$(curl -sS -o /dev/null -w '%{http_code}' \
        -X DELETE -H "Authorization: Bearer $token" \
        "https://api.vercel.com/v10/projects/$pid/env/$id?${team_arg%&}")
      if ! echo "$dcode" | grep -qE '^20'; then
        echo "  ❌ delete $key HTTP $dcode"; echo fail >> "$_tally"; continue
      fi
      local out; out="$(mktemp)"
      local ccode; ccode=$(curl -sS -o "$out" -w '%{http_code}' \
        -X POST -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        "https://api.vercel.com/v10/projects/$pid/env?${team_arg%&}" \
        -d "$(jq -nc --arg k "$key" --arg v "$value" --arg ty "$target_type" --argjson t "$targets_json" \
                '{key:$k, value:$v, type:$ty, target:$t}')")
      if echo "$ccode" | grep -qE '^20'; then
        echo "  ✅ $key  ($(echo "$targets_json" | jq -r 'join(",")'))"
        echo up >> "$_tally"
      else
        echo "  ❌ create $key HTTP $ccode"; cat "$out"
        echo fail >> "$_tally"
      fi
      rm -f "$out"
    done
  fi

  # Path B: encrypted → sensitive (PATCH in place, value unchanged)
  if [ "$target_type" = "sensitive" ] && [ "$enc" != "0" ]; then
    echo "── encrypted → sensitive (PATCH, value preserved) ──"
    jq -c '.envs[] | select(.type=="encrypted")' "$tmp" | while IFS= read -r entry; do
      local id key targets_json new_targets
      id=$(echo "$entry"      | jq -r '.id')
      key=$(echo "$entry"     | jq -r '.key')
      targets_json=$(echo "$entry" | jq -c '.target')
      if [ "$all_keys" = "0" ] && ! _looks_secretly_named "$key"; then
        echo "  ↷ $key  (skip — not credential-shaped)"
        echo sk >> "$_tally"
        continue
      fi
      new_targets=$(echo "$targets_json" | jq -c 'map(select(. != "development"))')
      [ "$(echo "$new_targets" | jq 'length')" -gt 0 ] || {
        echo "  ⚠️  $key: only targets development — can't be sensitive, skipping"
        echo sk >> "$_tally"
        continue
      }
      local out; out="$(mktemp)"
      local pcode; pcode=$(curl -sS -o "$out" -w '%{http_code}' \
        -X PATCH -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        "https://api.vercel.com/v10/projects/$pid/env/$id?${team_arg%&}" \
        -d "$(jq -nc --argjson t "$new_targets" '{type:"sensitive", target:$t}')")
      if echo "$pcode" | grep -qE '^20'; then
        local dropped=""; [ "$targets_json" != "$new_targets" ] && dropped="  (dropped development)"
        echo "  ✅ $key$dropped"
        echo up >> "$_tally"
      else
        echo "  ❌ PATCH $key HTTP $pcode"; cat "$out"
        echo fail >> "$_tally"
      fi
      rm -f "$out"
    done
  fi

  _n_up=$(grep -c '^up$'   "$_tally" 2>/dev/null || echo 0)
  _n_sk=$(grep -c '^sk$'   "$_tally" 2>/dev/null || echo 0)
  _n_fail=$(grep -c '^fail$' "$_tally" 2>/dev/null || echo 0)
  rm -f "$_tally" "$tmp"
  [ -n "${SECRET_SUMMARY_FILE:-}" ] && \
    echo "$_proj_name|$_n_up|$_n_sk|$_n_fail" >> "$SECRET_SUMMARY_FILE"
  echo "🎉 done  ($_n_up upgraded, $_n_sk skipped, $_n_fail failed)"
}

cmd_vercel_upgrade() {
  local dry=0 target_type="sensitive" all=0 all_keys=0 proj=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)   dry=1; shift ;;
      --encrypted) target_type="encrypted"; shift ;;
      --sensitive) target_type="sensitive"; shift ;;
      --all)       all=1; shift ;;
      --all-keys)  all_keys=1; shift ;;
      -*) echo "❌ unknown arg $1" >&2; exit 1 ;;
      *)  [ -z "$proj" ] && proj="$1" || { echo "❌ multiple projects given" >&2; exit 1; }; shift ;;
    esac
  done

  if [ "$all" = "1" ]; then
    [ -z "$proj" ] || { echo "❌ --all takes no project arg" >&2; exit 1; }
    local f n first=1
    local summary_file; summary_file=$(mktemp)
    export SECRET_SUMMARY_FILE="$summary_file"
    for f in "$CONFIG_DIR"/*.json; do
      [ -f "$f" ] || continue
      n=$(basename "$f" .json)
      [ "$n" = "_aliases" ] && continue
      [ -n "$(jq -r '.vercel.projectId // empty' "$f")" ] || continue
      [ "$first" = 1 ] || echo
      first=0
      echo "════════ $n ════════"
      CFG="$f"
      _vercel_upgrade_one "$dry" "$target_type" "$all_keys"
    done

    # Grand total
    echo
    echo "════════ TOTAL ════════"
    if [ -s "$summary_file" ]; then
      local up_verb sk_verb
      if [ "$dry" = "1" ]; then
        up_verb="would upgrade"; sk_verb="would skip"
      else
        up_verb="upgraded";      sk_verb="skipped"
      fi
      awk -F'|' -v up_verb="$up_verb" -v sk_verb="$sk_verb" '
        { n++; up+=$2; sk+=$3; fl+=$4 }
        END {
          printf "  %d project%s   %s %d   %s %d",
            n, (n==1?"":"s"), up_verb, up, sk_verb, sk;
          if (fl+0 > 0) printf "   failed %d", fl;
          print ""
        }
      ' "$summary_file"
    else
      echo "  (no projects matched — no vercel block in any config?)"
    fi
    rm -f "$summary_file"
    unset SECRET_SUMMARY_FILE
    return 0
  fi

  [ -n "$proj" ] || { usage; exit 1; }
  CFG=$(resolve_project "$proj") || exit 1
  _vercel_upgrade_one "$dry" "$target_type" "$all_keys"
}

_print_single_notes() {
  # $1 = config path, $2 = secret key
  local cfg_path="$1" key="$2"
  local strategy targets note nsteps
  strategy=$(jq -r --arg k "$key" '.secrets[$k].strategy // empty' "$cfg_path")
  [ -n "$strategy" ] || return 1
  targets=$(jq -r --arg k "$key" '.secrets[$k].targets | join(",")' "$cfg_path")
  note=$(jq -r --arg k "$key" '.secrets[$k]._note // empty' "$cfg_path")
  nsteps=$(jq -r --arg k "$key" '.secrets[$k].manualSteps | length // 0' "$cfg_path")

  echo "── $(basename "$cfg_path" .json) / $key ──"
  echo "strategy: $strategy"
  echo "targets:  $targets"
  if [ -n "$note" ]; then
    echo; echo "Note:"
    printf '  %s\n' "$note"
  fi
  if [ "$nsteps" -gt 0 ]; then
    echo; echo "Rotation steps:"
    jq -r --arg k "$key" '.secrets[$k].manualSteps | to_entries[] | "  \(.key+1). \(.value)"' "$cfg_path"
  fi
}

_keys_with_steps() {
  # $1 = config path → emit each key that has non-empty manualSteps
  jq -r '.secrets | to_entries[] | select((.value.manualSteps // [] | length) > 0) | .key' "$1"
}

cmd_notes() {
  case "$#" in
    2)
      # Single secret in a single project
      CFG=$(resolve_project "$1") || exit 1
      _print_single_notes "$CFG" "$2" \
        || { echo "❌ secret '$2' not in $(basename "$CFG" .json)" >&2; exit 1; }
      ;;
    1)
      # All secrets with manualSteps in this project
      CFG=$(resolve_project "$1") || exit 1
      local keys k first=1
      keys=$(_keys_with_steps "$CFG")
      if [ -z "$keys" ]; then
        echo "(no secrets with manualSteps in $(basename "$CFG" .json))"
        return 0
      fi
      printf '%s\n' "$keys" | while IFS= read -r k; do
        [ -n "$k" ] || continue
        [ "$first" = 1 ] || echo
        first=0
        _print_single_notes "$CFG" "$k"
      done
      ;;
    0)
      # All secrets with manualSteps across all configs
      local f n keys k printed=0
      for f in "$CONFIG_DIR"/*.json; do
        [ -f "$f" ] || continue
        n=$(basename "$f" .json)
        [ "$n" = "_aliases" ] && continue
        keys=$(_keys_with_steps "$f")
        [ -n "$keys" ] || continue
        printf '%s\n' "$keys" | while IFS= read -r k; do
          [ -n "$k" ] || continue
          [ "$printed" = 0 ] || echo
          printed=1
          _print_single_notes "$f" "$k"
        done
        printed=1
      done
      ;;
    *) usage; exit 1 ;;
  esac
}

cmd_pull() {
  CFG=$(resolve_project "$1") || exit 1
  local key="${2:-}"
  local proj acct
  proj=$(cfg .gcpProject)
  [ -n "$proj" ] || { echo "❌ pull only works with gcpSecretManager (no gcpProject in config)" >&2; exit 1; }
  acct=$(cfg .gcpAccount)
  local gargs; gargs="--project $proj"
  [ -n "$acct" ] && gargs="$gargs --account $acct"

  local keys
  if [ -n "$key" ]; then keys="$key"
  else keys=$(jq -r '.secrets | keys[]' "$CFG")
  fi
  local k
  for k in $keys; do
    local has; has=$(jq -r --arg k "$k" '.secrets[$k].targets | index("gcpSecretManager") // empty' "$CFG")
    [ -n "$has" ] || { echo "  skip $k (no gcpSecretManager target)"; continue; }
    local name; name=$(gcp_secret_name "$k")
    local v; v=$($GCLOUD secrets versions access latest --secret "$name" $gargs 2>/dev/null) || {
      echo "  ⚠️  $k: read failed"; continue
    }
    prop_local_env "$k" "$v"
  done
}

# ────────────────────────── main ──────────────────────────

[ $# -gt 0 ] || { usage; exit 1; }
sub="$1"; shift
case "$sub" in
  ls)              cmd_ls ;;
  list)            [ $# -ge 1 ] || { usage; exit 1; }; cmd_list "$1" ;;
  rotate)          [ $# -ge 2 ] || { usage; exit 1; }; cmd_rotate "$1" "$2" ;;
  set)             [ $# -ge 2 ] || { usage; exit 1; }; cmd_set "$@" ;;
  add)             [ $# -ge 2 ] || { usage; exit 1; }; cmd_add "$@" ;;
  remove)          [ $# -ge 2 ] || { usage; exit 1; }; cmd_remove "$@" ;;
  pull)            [ $# -ge 1 ] || { usage; exit 1; }; cmd_pull "$@" ;;
  notes)           cmd_notes "$@" ;;
  vercel-upgrade)  cmd_vercel_upgrade "$@" ;;
  -h|--help|help) usage ;;
  *) echo "unknown subcommand: $sub" >&2; usage; exit 1 ;;
esac
