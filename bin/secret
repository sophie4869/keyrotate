#!/usr/bin/env bash
#
# secret — unified secret rotate/set/pull across projects
# Reads configs from $SECRET_CONFIG_DIR (default ~/.config/keyrotate/<name>.json).
#
# Strategies:
#   atlas-mongodb : PATCH Atlas user password → assemble mongodb+srv://… URI
#   random        : openssl rand → base62 (default) or hex
#   manual        : value comes from --value / --from-stdin (set only, no rotate)
#
# Targets:
#   gcpSecretManager  cloudRun  vercel  koyeb  github  userPassword  ssh  localEnv
#
# Usage:
#   secret ls
#   secret list <project>
#   secret rotate <project> <KEY>
#   secret set    <project> <KEY> [--value V | --from-stdin]
#   secret pull   <project> [KEY]
#
set -euo pipefail

CONFIG_DIR="${SECRET_CONFIG_DIR:-$HOME/.config/keyrotate}"
GCLOUD="${GCLOUD:-$HOME/Downloads/google-cloud-sdk/bin/gcloud}"
ATLAS_API_VERSION="${ATLAS_API_VERSION:-2024-08-05}"

need() { command -v "$1" >/dev/null 2>&1 || { echo "❌ $1 required" >&2; exit 1; }; }
need jq; need curl; need openssl
[ -x "$GCLOUD" ] || GCLOUD="$(command -v gcloud || true)"

usage() {
  cat <<'EOF' >&2
secret ls                                       list known projects
secret list           <project>                 list secrets in a project config
secret rotate         <project> [--targets a,b] <KEY> [KEY...]
                                                rotate (atlas-mongodb / random). Multiple keys on the
                                                same project share a single Vercel redeploy at the end
                                                (deduplicated by projectId, incl. crossProjectPropagate).
                                                --targets restricts which sinks to push to, across the owning
                                                project AND crossProjectPropagate (each downstream entry's
                                                targets are intersected with the list). e.g. `--targets koyeb`
                                                hits only koyeb sinks wherever they live; `--targets ssh`
                                                retries just ssh everywhere after a partial failure.
                                                --only-project P restricts to project P (its own targets, or
                                                the single matching crossProjectPropagate entry). Combine
                                                them: `secret set s0 JWT_SECRET --value V --targets koyeb`
                                                pushes to just VocabCompanion's Koyeb without touching the fleet.
secret set            <project> [--targets a,b] <KEY=V | KEY --value V | KEY --from-stdin> [more pairs...]
                                                Pair forms (mix freely in one invocation):
                                                  KEY=value         shorthand (split on FIRST '=')
                                                  KEY --value V     explicit form
                                                  KEY --from-stdin  read from stdin (single-key only)
                                                  KEY                prompt interactively (single-key only)
                                                Multiple pairs share one Vercel redeploy at the end
                                                (deduplicated by projectId).
                                                --targets behaves the same as for rotate.
secret add            <project> <KEY> --value V [--separator ,]  append item to a delimited list value (read+dedupe+push)
secret remove         <project> <KEY> --value V [--separator ,]  remove item from a delimited list value
secret pull           <project> [KEY]           resync localEnv from GCP Secret Manager
secret get            <project> <KEY>           print current value to stdout (humans only — never call from an agent unless the user explicitly asks for the raw value)
secret vercel-upgrade <project|--all> [--dry-run] [--encrypted|--sensitive] [--all-keys]
                                                upgrade Vercel env vars (plain → sensitive, encrypted → sensitive in-place).
                                                By default only credential-shaped names get upgraded
                                                (*_SECRET, *_TOKEN, *_KEY, *_PASSWORD, *_PRIVATE, *_CREDENTIALS, MONGODB_URI, …).
                                                --all-keys overrides the heuristic and upgrades every var.
                                                --all iterates every config that declares a vercel block.
secret notes          [project [KEY]]           show rotation playbooks. no args = every secret with manualSteps across all
                                                projects; one arg = all in that project; two args = that one secret.

Secrets may declare postRotateCheck.type="jwt-auth-status" to run a post-write
self-check: keyrotate signs a short-lived probe JWT with the new value and calls
each configured /auth/status verifier. Any rejection exits red.
EOF
}

CFG=""
cfg()     { jq -r "$1 // empty" "$CFG"; }
cfg_arr() { jq -r "$1 // empty | .[]?" "$CFG"; }
cfg_root(){ jq -r '.projectRoot' "$CFG"; }
lc()      { tr '[:upper:]' '[:lower:]'; }

resolve_project() {
  local q="$1" f name aliased
  # 1. alias map
  if [ -f "$CONFIG_DIR/_aliases.json" ]; then
    aliased=$(jq -r --arg q "$q" '.[$q] // empty' "$CONFIG_DIR/_aliases.json")
    [ -n "$aliased" ] && q="$aliased"
  fi
  # 2. exact name
  f="$CONFIG_DIR/$q.json"; [ -f "$f" ] && { echo "$f"; return 0; }
  # 3. case-insensitive prefix match
  local qlc; qlc=$(printf '%s' "$q" | lc)
  local hits="" hitcount=0
  for f in "$CONFIG_DIR"/*.json; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .json)
    [ "$name" = "_aliases" ] && continue
    local nlc; nlc=$(printf '%s' "$name" | lc)
    case "$nlc" in "$qlc"*) hits="$hits $f"; hitcount=$((hitcount+1));; esac
  done
  case "$hitcount" in
    0) echo "❌ no project matches '$q' in $CONFIG_DIR" >&2; return 1 ;;
    1) echo "${hits# }" ;;
    *) echo "❌ ambiguous '$q':" >&2
       for f in $hits; do echo "    $(basename "$f" .json)" >&2; done
       return 1 ;;
  esac
}

# ────────────────────────── value generation ──────────────────────────

gen_random() {
  local length="$1" encoding="${2:-base62}"
  case "$encoding" in
    hex)    openssl rand -hex "$length" | head -c "$length" ;;
    base62) openssl rand -base64 $((length*2)) | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c "$length" ;;
    *) echo "❌ unknown encoding $encoding" >&2; return 1 ;;
  esac
}

gen_atlas_mongodb() {
  local key="$1"
  local pid;   pid=$(cfg ".secrets[\"$key\"].atlas.projectId")
  local user;  user=$(cfg ".secrets[\"$key\"].atlas.dbUser")
  local authdb;authdb=$(cfg ".secrets[\"$key\"].atlas.authDb")
  local host;  host=$(cfg ".secrets[\"$key\"].atlas.clusterHost")
  local params;params=$(cfg ".secrets[\"$key\"].atlas.uriParams")
  local dbname;dbname=$(cfg ".secrets[\"$key\"].atlas.dbName")   # optional; embeds /<dbname> in URI path
  local ksvc;  ksvc=$(cfg '.atlasKeychainService'); ksvc="${ksvc:-atlas-api}"

  for v in pid user authdb host params; do
    eval "[ -n \"\${$v}\" ]" || { echo "❌ atlas.$v missing for $key" >&2; return 1; }
  done

  local pub priv
  pub=$(security find-generic-password -s "$ksvc" -a public  -w 2>/dev/null) \
    || { echo "❌ atlas keychain '$ksvc' missing" >&2; return 1; }
  priv=$(security find-generic-password -s "$ksvc" -a private -w 2>/dev/null) \
    || { echo "❌ atlas keychain '$ksvc' missing private key" >&2; return 1; }

  local new_pw; new_pw=$(openssl rand -base64 60 | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 40)
  [ "${#new_pw}" -ge 32 ] || { echo "❌ pw too short" >&2; return 1; }

  echo "🌐 PATCH Atlas user '$user' (project $pid)…" >&2
  local code tmp; tmp="$(mktemp)"
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    --user "$pub:$priv" --digest -X PATCH \
    "https://cloud.mongodb.com/api/atlas/v2/groups/$pid/databaseUsers/$authdb/$user" \
    -H "Accept: application/vnd.atlas.$ATLAS_API_VERSION+json" \
    -H "Content-Type: application/vnd.atlas.$ATLAS_API_VERSION+json" \
    -d "$(jq -nc --arg p "$new_pw" '{password:$p}')")
  if [ "$code" != "200" ]; then
    echo "❌ Atlas HTTP $code" >&2; cat "$tmp" >&2; rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"
  echo "✅ Atlas password rotated" >&2
  # Build URI. If atlas.dbName is set, embed it in the path so consumers that
  # parse the db name from the URI (e.g. mongodump in CI backup workflows) work.
  if [ -n "$dbname" ]; then
    printf 'mongodb+srv://%s:%s@%s/%s?%s' "$user" "$new_pw" "$host" "$dbname" "$params"
  else
    printf 'mongodb+srv://%s:%s@%s/?%s' "$user" "$new_pw" "$host" "$params"
  fi
}

# ────────────────────────── post-rotation checks ──────────────────────────

_b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

_jwt_hs256_probe() {
  local secret="$1" issuer="$2" subject="$3" audience="$4" ttl="$5" extra_claims="${6:-}"
  local now exp header payload base signing_input signature
  now=$(date +%s)
  exp=$((now + ttl))
  header=$(jq -nc '{alg:"HS256",typ:"JWT"}' | _b64url)
  # Configured extra claims (postRotateCheck.claims, e.g. {userId,username}) let
  # the probe satisfy downstream verifiers that require app-specific claims —
  # every s0phi3 verifier rejects a claimless token because real access tokens
  # always carry userId. Reserved claims are applied ON TOP of the extras via
  # jq's `+` (right operand wins), so a stray configured iss/exp/purpose can
  # never spoof the probe's identity or lifetime.
  [ -n "$extra_claims" ] || extra_claims='{}'
  if [ -n "$audience" ]; then
    base=$(jq -nc \
      --arg iss "$issuer" --arg sub "$subject" --arg aud "$audience" \
      --argjson iat "$now" --argjson exp "$exp" \
      '{iss:$iss,sub:$sub,aud:$aud,iat:$iat,nbf:$iat,exp:$exp,purpose:"keyrotate-post-rotate-check"}')
  else
    base=$(jq -nc \
      --arg iss "$issuer" --arg sub "$subject" \
      --argjson iat "$now" --argjson exp "$exp" \
      '{iss:$iss,sub:$sub,iat:$iat,nbf:$iat,exp:$exp,purpose:"keyrotate-post-rotate-check"}')
  fi
  payload=$(jq -nc --argjson extra "$extra_claims" --argjson base "$base" '$extra + $base' | _b64url)
  signing_input="$header.$payload"
  signature=$(printf '%s' "$signing_input" \
    | openssl dgst -binary -sha256 -hmac "$secret" \
    | _b64url)
  printf '%s.%s' "$signing_input" "$signature"
}

_run_post_rotate_check_one() {
  local row="$1"
  local key value cfg_path
  key=$(echo "$row" | jq -r '.key')
  value=$(echo "$row" | jq -r '.value')
  cfg_path=$(echo "$row" | jq -r '.cfg')
  local check_json type
  check_json=$(jq -c --arg k "$key" '.secrets[$k].postRotateCheck // empty' "$cfg_path")
  [ -n "$check_json" ] && [ "$check_json" != "null" ] || return 0

  type=$(echo "$check_json" | jq -r '.type // "jwt-auth-status"')
  case "$type" in
    jwt-auth-status|jwtAuthStatus) ;;
    *) echo "❌ postRotateCheck: unsupported type '$type' for $key" >&2; return 1 ;;
  esac

  local services_len
  services_len=$(echo "$check_json" | jq -r '.services | length // 0')
  [ "$services_len" -gt 0 ] || { echo "❌ postRotateCheck: services[] required for $key" >&2; return 1; }

  local issuer subject audience ttl timeout retries retry_delay token claims
  issuer=$(echo "$check_json" | jq -r '.issuer // "keyrotate"')
  subject=$(echo "$check_json" | jq -r '.subject // "keyrotate-probe"')
  audience=$(echo "$check_json" | jq -r '.audience // empty')
  ttl=$(echo "$check_json" | jq -r '.ttlSeconds // 180')
  timeout=$(echo "$check_json" | jq -r '.timeoutSeconds // 10')
  retries=$(echo "$check_json" | jq -r '.retries // 12')
  retry_delay=$(echo "$check_json" | jq -r '.retryDelaySeconds // 10')
  claims=$(echo "$check_json" | jq -c '.claims // {}')
  token=$(_jwt_hs256_probe "$value" "$issuer" "$subject" "$audience" "$ttl" "$claims")

  echo "🔎 postRotateCheck: $key jwt-auth-status ($services_len service(s))" >&2

  local rc=0 i entry name url method header prefix attempt code tmp ok
  i=0
  while [ "$i" -lt "$services_len" ]; do
    entry=$(echo "$check_json" | jq -c ".services[$i]")
    name=$(echo "$entry" | jq -r '.name // empty')
    url=$(echo "$entry" | jq -r '.url // empty')
    method=$(echo "$entry" | jq -r '.method // "GET"')
    header=$(echo "$entry" | jq -r '.header // "Authorization"')
    prefix=$(echo "$entry" | jq -r '.prefix // "Bearer "')
    [ -n "$name" ] || name="$url"
    if [ -z "$url" ]; then
      echo "  ❌ postRotateCheck: services[$i].url missing" >&2
      rc=1; i=$((i+1)); continue
    fi

    ok=0
    attempt=1
    while [ "$attempt" -le "$retries" ]; do
      tmp="$(mktemp)"
      if ! code=$(curl -sS -o "$tmp" -w '%{http_code}' \
        --max-time "$timeout" \
        -X "$method" \
        -H "$header: ${prefix}${token}" \
        "$url" 2>/dev/null); then
        code="000"
      fi
      if echo "$code" | grep -qE '^2'; then
        echo "  ✅ auth status: $name accepted probe (HTTP $code)" >&2
        ok=1
        rm -f "$tmp"
        break
      fi
      if [ "$attempt" -lt "$retries" ]; then
        echo "  ⏳ auth status: $name rejected probe (HTTP $code), retry $attempt/$retries" >&2
        sleep "$retry_delay"
      else
        echo "  ❌ auth status: $name rejected probe (HTTP $code)" >&2
        if [ -s "$tmp" ]; then
          printf '      ' >&2
          head -c 500 "$tmp" >&2
          echo >&2
        fi
      fi
      rm -f "$tmp"
      attempt=$((attempt+1))
    done
    [ "$ok" = "1" ] || rc=1
    i=$((i+1))
  done
  return $rc
}

run_post_rotate_checks() {
  # Newline-separated JSON rows. Keeping the newly-generated value in structured
  # in-memory rows avoids leaking it through stdout and handles punctuation.
  local rows="$1"
  [ -n "$rows" ] || return 0
  local row rc=0
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    _run_post_rotate_check_one "$row" || rc=1
  done <<< "$rows"
  return $rc
}

_POST_ROTATE_CHECK_ROWS=""

_queue_post_rotate_check() {
  local key="$1" value="$2" cfg_path="$3"
  local has_check
  has_check=$(jq -r --arg k "$key" '.secrets[$k].postRotateCheck != null' "$cfg_path")
  [ "$has_check" = "true" ] || return 0
  _POST_ROTATE_CHECK_ROWS+="$(jq -nc --arg k "$key" --arg v "$value" --arg c "$cfg_path" \
    '{key:$k,value:$v,cfg:$c}')"$'\n'
}

# ────────────────────────── propagation ──────────────────────────

gcp_secret_name() {
  local key="$1" explicit
  explicit=$(cfg ".secrets[\"$key\"].gcpSecretName")
  if [ -n "$explicit" ]; then printf '%s' "$explicit"
  else printf '%s' "$key" | lc | tr '_' '-'
  fi
}

prop_gcp_secret_manager() {
  local key="$1" value="$2"
  local proj acct name
  proj=$(cfg .gcpProject); [ -n "$proj" ] || { echo "❌ no gcpProject" >&2; return 1; }
  acct=$(cfg .gcpAccount)
  name=$(gcp_secret_name "$key")
  local gargs; gargs="--project $proj"
  [ -n "$acct" ] && gargs="$gargs --account $acct"

  local created=0
  if ! $GCLOUD secrets describe "$name" $gargs >/dev/null 2>&1; then
    echo "  → creating GCP secret '$name'…" >&2
    $GCLOUD secrets create "$name" $gargs --replication-policy=automatic
    created=1
  fi
  printf '%s' "$value" | $GCLOUD secrets versions add "$name" $gargs --data-file=- >/dev/null
  echo "  ✅ gcpSecretManager: $name updated" >&2

  # On first creation, auto-grant secretAccessor to the Cloud Run runtime SAs
  # so that the subsequent `gcloud run services update --update-secrets KEY=name:latest`
  # actually works. Without this, prop_cloud_run fails with:
  #   "Permission denied on secret ... The service account used must be granted
  #    the 'Secret Manager Secret Accessor' role"
  if [ "$created" = 1 ]; then
    _grant_secret_accessor "$name" "$proj" "$gargs"
  fi
}

_grant_secret_accessor() {
  local name="$1" proj="$2" gargs="$3"
  local region; region=$(cfg '.cloudRun.region')

  # Collect distinct service-account names from configured Cloud Run services.
  # Empty serviceAccountName means the service uses the default compute SA.
  local sas=""
  if [ -n "$region" ]; then
    sas=$(cfg_arr '.cloudRun.services' | while IFS= read -r svc; do
      [ -n "$svc" ] || continue
      $GCLOUD run services describe "$svc" $gargs --region "$region" \
        --format='value(spec.template.spec.serviceAccountName)' 2>/dev/null
    done | sort -u | sed '/^$/d')
  fi

  # If no SA discoverable from Cloud Run services, fall back to the project's
  # default compute service account.
  if [ -z "$sas" ]; then
    local pnum
    pnum=$($GCLOUD projects describe "$proj" $gargs \
            --format='value(projectNumber)' 2>/dev/null || true)
    [ -n "$pnum" ] && sas="${pnum}-compute@developer.gserviceaccount.com"
  fi

  if [ -z "$sas" ]; then
    echo "  ⚠️  couldn't determine a service account to grant secretAccessor on '$name' — grant manually if Cloud Run binding fails" >&2
    return 0
  fi

  printf '%s\n' "$sas" | while IFS= read -r sa; do
    [ -n "$sa" ] || continue
    if $GCLOUD secrets add-iam-policy-binding "$name" $gargs \
         --member="serviceAccount:$sa" \
         --role='roles/secretmanager.secretAccessor' \
         --condition=None >/dev/null 2>&1; then
      echo "  ✅ granted secretAccessor on '$name' to $sa" >&2
    else
      echo "  ⚠️  failed to grant secretAccessor on '$name' to $sa (you may already have it bound — verify with: $GCLOUD secrets get-iam-policy $name $gargs)" >&2
    fi
  done
}

prop_cloud_run() {
  local key="$1" _v="$2"
  local proj acct region name
  proj=$(cfg .gcpProject);   [ -n "$proj" ] || { echo "❌ cloudRun needs gcpProject" >&2; return 1; }
  acct=$(cfg .gcpAccount)
  region=$(cfg '.cloudRun.region')
  name=$(gcp_secret_name "$key")
  local gargs; gargs="--project $proj --region $region"
  [ -n "$acct" ] && gargs="$gargs --account $acct"

  local svc
  cfg_arr '.cloudRun.services' | while IFS= read -r svc; do
    [ -n "$svc" ] || continue
    # drop any plain env var with same name first; harmless if it doesn't exist
    $GCLOUD run services update "$svc" $gargs --remove-env-vars "$key" >/dev/null 2>&1 || true
    # A failed deploy on ONE service (e.g. a container that won't boot) must not
    # abort the whole propagation under `set -e` — that silently starves every
    # later target/project (incl. koyeb) of the new value. Warn and continue.
    if ! $GCLOUD run services update "$svc" $gargs --update-secrets "$key=$name:latest" >/dev/null; then
      echo "  ⚠️  cloudRun: $svc update FAILED — skipping, continuing to other targets" >&2
      continue
    fi
    echo "  ✅ cloudRun: $svc ← $key=$name:latest" >&2
  done
}

prop_vercel() {
  local key="$1" value="$2"
  local pid org token tmp
  pid=$(cfg '.vercel.projectId'); [ -n "$pid" ] || { echo "❌ no vercel.projectId" >&2; return 1; }
  org=$(cfg '.vercel.orgId')
  token=$(security find-generic-password -s vercel-api -a token -w 2>/dev/null || true)
  [ -n "$token" ] || token="${VERCEL_TOKEN:-}"
  [ -n "$token" ] || { echo "❌ need vercel token in keychain 'vercel-api' (or \$VERCEL_TOKEN)" >&2; return 1; }

  local team_qs=""; [ -n "$org" ] && team_qs="?teamId=$org"
  tmp="$(mktemp)"
  curl -sS -H "Authorization: Bearer $token" \
    "https://api.vercel.com/v10/projects/$pid/env$team_qs" >"$tmp"

  local env
  cfg_arr '.vercel.envs' | while IFS= read -r env; do
    [ -n "$env" ] || continue
    # Vercel rule: sensitive type cannot target 'development'. Skip dev silently
    # (local dev gets the value via .env / localEnv target anyway).
    if [ "$env" = "development" ]; then
      echo "  ↷ vercel: skip $key on development (sensitive type can't target it)" >&2
      continue
    fi
    # delete any existing entry for this key+env
    jq -r --arg k "$key" --arg e "$env" \
      '.envs[]? | select(.key==$k and (.target | index($e))) | .id' "$tmp" \
    | while IFS= read -r id; do
        [ -n "$id" ] || continue
        curl -sS -X DELETE -H "Authorization: Bearer $token" \
          "https://api.vercel.com/v10/projects/$pid/env/$id$team_qs" >/dev/null
      done
    # create as sensitive
    local code; local out; out="$(mktemp)"
    code=$(curl -sS -o "$out" -w '%{http_code}' -X POST \
      -H "Authorization: Bearer $token" \
      -H "Content-Type: application/json" \
      "https://api.vercel.com/v10/projects/$pid/env$team_qs" \
      -d "$(jq -nc --arg k "$key" --arg v "$value" --arg t "$env" \
              '{key:$k, value:$v, type:"sensitive", target:[$t]}')")
    if ! echo "$code" | grep -qE '^20'; then
      echo "  ❌ vercel($env) HTTP $code"; cat "$out"; rm -f "$out" "$tmp"; return 1
    fi
    rm -f "$out"
    echo "  ✅ vercel: $key on $env (sensitive)" >&2
  done
  rm -f "$tmp"

  # Vercel doesn't auto-redeploy on env-var change — running functions keep
  # the env snapshot they were built with, so a rotated value sits unused
  # until the next deploy. For atlas-mongodb in particular, the old password
  # is immediately invalid → 5xx until redeploy. Trigger a redeploy of the
  # latest READY production deployment, unless vercel.autoRedeploy is false.
  local auto; auto=$(cfg '.vercel.autoRedeploy')
  [ "$auto" = "false" ] && return 0
  # Only redeploy if production is one of the targeted envs (no point
  # redeploying prod when the user explicitly only pushed to preview).
  local has_prod; has_prod=$(jq -r '.vercel.envs[]? | select(.=="production")' "$CFG")
  [ -n "$has_prod" ] || return 0
  _maybe_queue_vercel_redeploy "$token" "$pid" "$org"
}

# ── batched-deploy support ────────────────────────────────────────────────
# When DEFER_VERCEL_REDEPLOY=1 (set by cmd_rotate in multi-key mode), the
# inline redeploy at the end of prop_vercel is suppressed; instead the
# (token, projectId, orgId) tuple is queued and flushed once at the very
# end, deduplicated by projectId. Net: rotating N keys that hit the same
# Vercel project triggers 1 redeploy, not N. Works across crossProjectPropagate
# too (the same project queued multiple times still redeploys once).
DEFER_VERCEL_REDEPLOY=0
_PENDING_VERCEL_REDEPLOYS=""   # newline-separated "token|pid|org" tuples

_maybe_queue_vercel_redeploy() {
  local token="$1" pid="$2" org="$3"
  if [ "$DEFER_VERCEL_REDEPLOY" = "1" ]; then
    # printf to handle empty $org cleanly; newline separator survives word-split
    _PENDING_VERCEL_REDEPLOYS+="$(printf '%s|%s|%s\n' "$token" "$pid" "$org")"$'\n'
  else
    _vercel_redeploy_production "$token" "$pid" "$org"
  fi
}

_flush_vercel_redeploys() {
  [ -n "$_PENDING_VERCEL_REDEPLOYS" ] || return 0
  local seen=""  # space-padded list of pids already flushed
  local line token pid org
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    IFS='|' read -r token pid org <<< "$line"
    case " $seen " in
      *" $pid "*) continue ;;
    esac
    seen="$seen $pid"
    _vercel_redeploy_production "$token" "$pid" "$org"
  done <<< "$_PENDING_VERCEL_REDEPLOYS"
  _PENDING_VERCEL_REDEPLOYS=""
}

_vercel_redeploy_production() {
  local token="$1" pid="$2" org="$3"
  local team_qs_amp=""; [ -n "$org" ] && team_qs_amp="teamId=$org&"
  local list source_id name resp new_id
  list=$(curl -sS -H "Authorization: Bearer $token" \
    "https://api.vercel.com/v6/deployments?projectId=$pid&${team_qs_amp}limit=10&target=production")
  source_id=$(echo "$list" | jq -r '.deployments[] | select(.state=="READY") | .uid' | head -1)
  if [ -z "$source_id" ]; then
    echo "  ⚠️  vercel: no READY production deployment found to redeploy from (skipping)" >&2
    return 0
  fi
  name=$(curl -sS -H "Authorization: Bearer $token" \
    "https://api.vercel.com/v9/projects/$pid?${team_qs_amp%&}" | jq -r '.name')
  resp=$(curl -sS -X POST -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    "https://api.vercel.com/v13/deployments?${team_qs_amp}forceNew=1" \
    -d "$(jq -nc --arg n "$name" --arg d "$source_id" \
          '{name:$n, deploymentId:$d, target:"production", meta:{action:"redeploy-from-keyrotate"}}')")
  new_id=$(echo "$resp" | jq -r '.id // empty')
  if [ -n "$new_id" ]; then
    echo "  🔄 vercel: production redeploy queued ($new_id) — env changes live in ~1–2 min" >&2
  else
    echo "  ⚠️  vercel: redeploy trigger returned no id: $(echo "$resp" | jq -c '.error // .' | head -c 200)" >&2
  fi
}

prop_koyeb() {
  local key="$1" value="$2"
  local ksvc; ksvc=$(cfg '.koyeb.tokenKeychainService'); ksvc="${ksvc:-koyeb-api}"
  local token
  token=$(security find-generic-password -s "$ksvc" -a token -w 2>/dev/null || true)
  [ -n "$token" ] || token="${KOYEB_TOKEN:-}"
  [ -n "$token" ] || { echo "❌ need koyeb token in keychain '$ksvc' (or \$KOYEB_TOKEN)" >&2; return 1; }
  local svc_name; svc_name=$(cfg '.koyeb.serviceName')

  # Account-level secret upsert. Koyeb REST API quirk: PUT/DELETE want a
  # SECRET *ID* (UUID) in the URL path, not the human-friendly name. So the
  # old "PUT by name → fall back to DELETE+POST" flow was hitting 4xx on
  # every hop when the secret already existed, ending with POST's
  # "already exists" error. Correct sequence:
  #   1. GET /v1/secrets?name=<key> to look up the ID
  #   2. If found → PUT /v1/secrets/{id} to update
  #   3. If not found → POST /v1/secrets to create
  local tmp code; tmp="$(mktemp)"
  local existing_id
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer $token" \
    -G --data-urlencode "name=$key" \
    "https://app.koyeb.com/v1/secrets")
  if echo "$code" | grep -qE '^20'; then
    # `.secrets[] | select(.name==$k) | .id` — Koyeb returns any secret whose
    # name contains the query, so filter for exact-name match to be safe.
    existing_id=$(jq -r --arg k "$key" '.secrets[]? | select(.name==$k) | .id' "$tmp" 2>/dev/null | head -1)
  fi

  if [ -n "$existing_id" ]; then
    code=$(curl -sS -o "$tmp" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      -X PUT "https://app.koyeb.com/v1/secrets/$existing_id" \
      -d "$(jq -nc --arg n "$key" --arg v "$value" '{name:$n, type:"SIMPLE", value:$v}')")
    local op="updated"
  else
    code=$(curl -sS -o "$tmp" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      -X POST "https://app.koyeb.com/v1/secrets" \
      -d "$(jq -nc --arg n "$key" --arg v "$value" '{name:$n, type:"SIMPLE", value:$v}')")
    local op="created"
  fi

  if ! echo "$code" | grep -qE '^20'; then
    echo "  ❌ koyeb HTTP $code"; cat "$tmp"; rm -f "$tmp"; return 1
  fi
  echo "  ✅ koyeb: $key $op" >&2

  # Auto-redeploy the service so the new value actually takes effect (Koyeb
  # doesn't hot-reload env vars — the running container holds the old value
  # until the next deployment). Skippable via koyeb.autoRedeploy: false.
  local auto; auto=$(cfg '.koyeb.autoRedeploy')
  if [ "$auto" = "false" ]; then
    echo "  ⏭  koyeb: skipping auto-redeploy (koyeb.autoRedeploy=false) — service still needs manual redeploy to see new value" >&2
    rm -f "$tmp"
    return 0
  fi

  [ -n "$svc_name" ] || {
    echo "  ⚠️  koyeb: no .koyeb.serviceName in config — cannot auto-redeploy (secret updated; do it manually in the Koyeb UI)" >&2
    rm -f "$tmp"
    return 0
  }

  # Resolve app_id if koyeb.appName is set (narrows the service search and
  # avoids collisions when multiple apps have a service with the same name).
  local app_name; app_name=$(cfg '.koyeb.appName')
  local app_id=""
  if [ -n "$app_name" ]; then
    code=$(curl -sS -o "$tmp" -w '%{http_code}' \
      -H "Authorization: Bearer $token" \
      -G --data-urlencode "name=$app_name" \
      "https://app.koyeb.com/v1/apps")
    if echo "$code" | grep -qE '^20'; then
      app_id=$(jq -r --arg n "$app_name" '.apps[]? | select(.name==$n) | .id' "$tmp" 2>/dev/null | head -1)
    fi
  fi

  # Look up service ID by name (filtered to app_id if we found one).
  local -a svc_query=("-G" "--data-urlencode" "name=$svc_name")
  [ -n "$app_id" ] && svc_query+=("--data-urlencode" "app_id=$app_id")
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer $token" \
    "${svc_query[@]}" \
    "https://app.koyeb.com/v1/services")
  local svc_id=""
  if echo "$code" | grep -qE '^20'; then
    svc_id=$(jq -r --arg n "$svc_name" '.services[]? | select(.name==$n) | .id' "$tmp" 2>/dev/null | head -1)
  fi

  if [ -z "$svc_id" ]; then
    echo "  ⚠️  koyeb: couldn't resolve service '${app_name:+$app_name/}$svc_name' to auto-redeploy (secret updated; redeploy manually)" >&2
    rm -f "$tmp"
    return 0
  fi

  # Trigger redeploy. Empty body → Koyeb re-uses the latest deployment
  # definition with fresh env values pulled from the current secret store.
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    -X POST "https://app.koyeb.com/v1/services/$svc_id/redeploy" \
    -d '{}')
  if echo "$code" | grep -qE '^20'; then
    echo "  🔄 koyeb: ${app_name:+$app_name/}$svc_name redeploy queued (new value live once the new revision is healthy)" >&2
  else
    echo "  ⚠️  koyeb: redeploy failed HTTP $code (secret updated OK — service needs manual redeploy)" >&2
    cat "$tmp" >&2
  fi
  rm -f "$tmp"
}

prop_user_password() {
  # Composite target: bcrypt+write to auth-backend Mongo AND push plaintext to a
  # set of GitHub Actions repos. Used for the test-user password rotation case
  # where the two sinks need the same secret in different forms.
  local key="$1" value="$2"
  command -v node >/dev/null 2>&1 || { echo "❌ node required for userPassword target" >&2; return 1; }
  command -v gh   >/dev/null 2>&1 || { echo "❌ gh CLI required for userPassword target" >&2; return 1; }

  local up_json
  up_json=$(jq -c --arg k "$key" '.secrets[$k].userPassword // empty' "$CFG")
  [ -n "$up_json" ] || { echo "❌ secrets[$key].userPassword block missing" >&2; return 1; }

  local proj_ref username db_name collection rounds
  proj_ref=$(echo "$up_json"   | jq -r '.projectRef // empty')
  username=$(echo "$up_json"   | jq -r '.username // empty')
  db_name=$(echo "$up_json"    | jq -r '.dbName // empty')
  collection=$(echo "$up_json" | jq -r '.collection // empty')
  rounds=$(echo "$up_json"     | jq -r '.bcryptRounds // empty')
  [ -n "$proj_ref" ] || { echo "❌ userPassword.projectRef missing" >&2; return 1; }
  [ -n "$username" ] || { echo "❌ userPassword.username missing" >&2; return 1; }

  # Resolve projectRef → its config → first localEnv file → read MONGODB_URI
  local ref_cfg ref_root env_file env_path mongo_uri
  ref_cfg=$(resolve_project "$proj_ref") || return 1
  ref_root=$(jq -r '.projectRoot' "$ref_cfg")
  env_file=$(jq -r '.localEnv[0].file // empty' "$ref_cfg")
  [ -n "$env_file" ] || { echo "❌ projectRef '$proj_ref' has no localEnv to read MONGODB_URI from" >&2; return 1; }
  env_path="$ref_root/$env_file"
  if [ ! -f "$env_path" ]; then
    echo "❌ $env_path doesn't exist — run \`secret rotate $proj_ref MONGODB_URI\` first to populate it" >&2
    return 1
  fi
  mongo_uri=$(grep -E '^MONGODB_URI=' "$env_path" | head -1 | cut -d= -f2-)
  [ -n "$mongo_uri" ] || { echo "❌ MONGODB_URI not found in $env_path" >&2; return 1; }

  # If config didn't pin dbName, read it from the same .env (auth backend's source of truth).
  if [ -z "$db_name" ]; then
    db_name=$(grep -E '^DB_NAME=' "$env_path" | head -1 | cut -d= -f2-)
  fi

  # 1. Update Mongo user document via node helper
  local helper="$HOME/bin/secret-helpers/user-password.mjs"
  [ -f "$helper" ] || { echo "❌ helper missing at $helper" >&2; return 1; }
  local out
  if ! out=$(MONGODB_URI="$mongo_uri" USERNAME="$username" PASSWORD="$value" \
              DB_NAME="${db_name:-app_users}" \
              COLLECTION="${collection:-users}" \
              BCRYPT_ROUNDS="${rounds:-12}" \
              node "$helper" 2>&1); then
    echo "  ❌ userPassword: mongo write failed" >&2
    printf '%s\n' "$out" | sed 's/^/      /' >&2
    return 1
  fi
  echo "  ✅ userPassword: bcrypt'd & wrote to ${db_name:-app_users}.${collection:-users} for username='$username' ($out)" >&2

  # 2. Push plaintext to GitHub repos listed under userPassword.githubRepos
  local repos
  repos=$(echo "$up_json" | jq -r '.githubRepos[]? // empty')
  if [ -z "$repos" ]; then
    echo "  ℹ️  no .githubRepos under userPassword — skipping plaintext push" >&2
    return 0
  fi
  printf '%s\n' "$repos" | while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    if printf '%s' "$value" | gh secret set "$key" --repo "$repo" >/dev/null 2>&1; then
      echo "  ✅ userPassword: plaintext → $repo" >&2
    else
      echo "  ❌ userPassword: gh secret set failed for $repo" >&2
      return 1
    fi
  done
}

prop_github() {
  local key="$1" value="$2"
  command -v gh >/dev/null 2>&1 || { echo "❌ gh CLI required for github target (brew install gh)" >&2; return 1; }
  # Precedence:
  #   1. .secrets[KEY].github.repos  (per-secret override)
  #   2. .secrets[KEY].github.repo
  #   3. .github.repos / .github.repo (top-level default)
  local repos=""
  local per_repos per_repo top_repos top_repo
  per_repos=$(jq -r --arg k "$key" '.secrets[$k].github.repos[]?' "$CFG")
  per_repo=$(jq -r  --arg k "$key" '.secrets[$k].github.repo  // empty' "$CFG")
  if [ -n "$per_repos" ] || [ -n "$per_repo" ]; then
    repos="$per_repos"
    [ -n "$per_repo" ] && repos="$repos
$per_repo"
  else
    top_repos=$(jq -r '.github.repos[]?' "$CFG")
    top_repo=$(cfg '.github.repo')
    repos="$top_repos"
    [ -n "$top_repo" ] && repos="$repos
$top_repo"
  fi
  repos=$(printf '%s\n' "$repos" | sed '/^$/d' | sort -u)
  [ -n "$repos" ] || { echo "❌ no .github.repo / .github.repos for $key" >&2; return 1; }
  printf '%s\n' "$repos" | while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    if printf '%s' "$value" | gh secret set "$key" --repo "$repo" >/dev/null 2>&1; then
      echo "  ✅ github: $key on $repo" >&2
    else
      echo "  ❌ github: failed to set $key on $repo" >&2
      return 1
    fi
  done
}

prop_ssh() {
  # Writes the value to one or more paths on a remote host via ssh. Top-level:
  #   "ssh": { "host": "10.0.0.5", "user": "deploy",
  #            "keyFile": "~/.ssh/id_keyrotate", "port": 22 }   # user/keyFile/port optional
  # Per-secret config — two forms:
  #   (a) Legacy single-path, raw value:
  #         "ssh": { "path": "/var/secrets/foo" }
  #   (b) Multi-path, each optionally as a KEY=VALUE line update on a .env file:
  #         "ssh": { "paths": [
  #           { "path": "/var/secrets/foo" },                            # raw value
  #           { "path": "/srv/app/.env", "envKey": "MONGODB_URL" }       # update/insert KEY= line
  #         ]}
  # `envKey` mode preserves other lines in the target file (grep-out + append),
  # used to update a single env var inside a multi-var .env on a remote host
  # (e.g. a docker-compose env_file). Without `envKey`, behavior is unchanged
  # from the legacy form: raw value, file replaced entirely.
  local key="$1" value="$2"
  local host user keyfile port
  host=$(cfg '.ssh.host')
  [ -n "$host" ] || { echo "❌ no .ssh.host in config" >&2; return 1; }
  user=$(cfg '.ssh.user')
  keyfile=$(cfg '.ssh.keyFile')
  port=$(cfg '.ssh.port')

  # Resolve entries: prefer .ssh.paths (array), fall back to legacy .ssh.path (string).
  local entries_json legacy_path
  entries_json=$(cfg ".secrets[\"$key\"].ssh.paths")
  if [ -z "$entries_json" ] || [ "$entries_json" = "null" ]; then
    legacy_path=$(cfg ".secrets[\"$key\"].ssh.path")
    [ -n "$legacy_path" ] || { echo "❌ secrets[\"$key\"].ssh.path or .ssh.paths required for ssh target" >&2; return 1; }
    entries_json=$(jq -nc --arg p "$legacy_path" '[{path:$p}]')
  fi

  local target_spec="${user:+${user}@}${host}"
  local -a ssh_args=()
  [ -n "$keyfile" ] && ssh_args+=("-i" "${keyfile/#\~/$HOME}")
  [ -n "$port" ]    && ssh_args+=("-p" "$port")
  ssh_args+=("-o" "BatchMode=yes" "-o" "StrictHostKeyChecking=accept-new")

  local rc=0
  # Use process substitution so `rc` updates in the parent shell, not a subshell.
  while IFS= read -r entry; do
    local remote_path env_key
    remote_path=$(echo "$entry" | jq -r '.path')
    env_key=$(echo "$entry" | jq -r '.envKey // empty')

    # Path is interpolated into a remote sh -c command. Hard-reject anything
    # outside a conservative filesystem-path character set.
    case "$remote_path" in
      /*) : ;;
      *)  echo "❌ ssh.paths[].path must be absolute (got: '$remote_path')" >&2; rc=1; continue ;;
    esac
    case "$remote_path" in
      *[!A-Za-z0-9._/-]*)
        echo "❌ ssh.paths[].path may only contain A-Z a-z 0-9 . _ / - (got: '$remote_path')" >&2
        rc=1; continue ;;
    esac

    if [ -n "$env_key" ]; then
      # envKey mode: update/insert the matching `KEY=` line in a .env-style file.
      case "$env_key" in
        *[!A-Za-z0-9_]*)
          echo "❌ ssh.paths[].envKey may only contain A-Z a-z 0-9 _ (got: '$env_key')" >&2
          rc=1; continue ;;
      esac
      # Pipe the KEY=VALUE line via stdin to avoid putting the value on the
      # remote shell command line (which would be visible to ps).
      #
      # Important quirk: previous implementation wrote to a /tmp tempfile then
      # mv'd it to the target. That breaks on Synology + other setups where:
      #   - /tmp is on a different filesystem (mv → cp+rm, needs parent-dir
      #     write to delete existing target)
      #   - The target file is group-writable but the remote user doesn't
      #     own it (chmod fails with "Operation not permitted")
      # Direct in-place write only needs write permission on the FILE
      # itself, which is exactly what you typically have when a sibling
      # user has been granted access via `chgrp users + chmod 660`.
      # Atomicity tradeoff: brief window where the file is partially
      # written. Acceptable for .env files where the consumer re-reads at
      # next process start, not for binary or strict-format targets.
      if printf '%s=%s\n' "$env_key" "$value" | ssh "${ssh_args[@]}" "$target_spec" "
        umask 077
        if [ -f $remote_path ]; then
          KEEP=\$(grep -v -E '^${env_key}=' $remote_path 2>/dev/null || true)
        fi
        NEW_LINE=\$(cat)
        if [ -n \"\${KEEP:-}\" ]; then
          printf '%s\n%s\n' \"\$KEEP\" \"\$NEW_LINE\" > $remote_path
        else
          printf '%s\n' \"\$NEW_LINE\" > $remote_path
        fi
        chmod 600 $remote_path 2>/dev/null || true
      "; then
        echo "  ✅ ssh: ${target_spec}:${remote_path} ($env_key=)" >&2
      else
        echo "  ❌ ssh: failed writing $env_key to ${target_spec}:${remote_path}" >&2
        rc=1
      fi
    else
      # Raw-value mode (legacy): replace the entire file with just the value, chmod 600.
      if printf '%s' "$value" | ssh "${ssh_args[@]}" "$target_spec" \
           "cat > $remote_path && chmod 600 $remote_path"; then
        echo "  ✅ ssh: ${target_spec}:${remote_path}" >&2
      else
        echo "  ❌ ssh: failed writing to ${target_spec}:${remote_path}" >&2
        rc=1
      fi
    fi
  done < <(echo "$entries_json" | jq -c '.[]')
  return $rc
}

prop_local_env() {
  local key="$1" value="$2"
  local root has_override targets_json
  root=$(cfg_root)
  has_override=$(jq -r --arg k "$key" '.secrets[$k] | has("localEnv")' "$CFG")
  if [ "$has_override" = "true" ]; then
    targets_json=$(jq -c --arg k "$key" '.secrets[$k].localEnv' "$CFG")
  else
    targets_json=$(jq -c '.localEnv // []' "$CFG")
  fi
  echo "$targets_json" | jq -c '.[]?' | while IFS= read -r entry; do
    local file env_key abs tmp mode
    file=$(echo "$entry" | jq -r '.file')
    env_key=$(echo "$entry" | jq -r --arg k "$key" '.key // $k')
    # Per-entry chmod override (e.g. "640" so a sibling user in the file's
    # group can read it). Default 600 preserves original behavior.
    mode=$(echo "$entry" | jq -r '.mode // "600"')
    # Absolute path support: file starting with / is taken as-is; relative is
    # resolved against projectRoot like before. Enables a single canonical file
    # in a shared location (e.g. /Users/Shared/...) or in another user's home.
    case "$file" in
      /*) abs="$file" ;;
      *)  abs="$root/$file" ;;
    esac
    mkdir -p "$(dirname "$abs")"
    touch "$abs"
    tmp="$(mktemp)"
    grep -v -E "^${env_key}=" "$abs" >"$tmp" || true
    printf '%s=%s\n' "$env_key" "$value" >>"$tmp"
    mv "$tmp" "$abs"
    chmod "$mode" "$abs"
    echo "  ✅ localEnv: $file ($env_key, mode=$mode)" >&2
  done
}

_dispatch_target() {
  # $1 = target name, $2 = secret key, $3 = value
  case "$1" in
    gcpSecretManager) prop_gcp_secret_manager "$2" "$3" ;;
    cloudRun)         prop_cloud_run "$2" "$3" ;;
    vercel)           prop_vercel "$2" "$3" ;;
    koyeb)            prop_koyeb "$2" "$3" ;;
    github)           prop_github "$2" "$3" ;;
    userPassword)     prop_user_password "$2" "$3" ;;
    ssh)              prop_ssh "$2" "$3" ;;
    localEnv)         prop_local_env "$2" "$3" ;;
    *) echo "  ⚠️  unknown target '$1'" >&2 ;;
  esac
}

# Filter scoping: when non-empty, propagate_all only dispatches to targets in
# this comma-separated list — applied to BOTH the owning project's targets and
# each crossProjectPropagate entry's targets (intersection), not a wholesale
# cross-prop skip. Set by --targets in cmd_set/cmd_rotate; reset after the call.
TARGET_FILTER=""

# Project scoping: when non-empty, propagate_all pushes ONLY to the named
# project — either the owning project's own targets, or the single matching
# crossProjectPropagate entry. Everything else is skipped. Set by
# --only-project. Use to push a shared secret (e.g. a JWT signing key) to just
# one lagging downstream service without redeploying the whole fleet.
ONLY_PROJECT=""

# Returns 0 if a target name passes the current TARGET_FILTER, 1 otherwise.
_target_allowed() {
  [ -z "$TARGET_FILTER" ] && return 0
  case ",$TARGET_FILTER," in
    *",$1,"*) return 0 ;;
    *)        return 1 ;;
  esac
}

propagate_all() {
  local key="$1" value="$2" t
  local owning; owning=$(basename "$CFG" .json)
  # Canonicalize --only-project (resolve aliases like "vc" → "VocabCompanion")
  local only_canon=""
  if [ -n "$ONLY_PROJECT" ]; then
    only_canon=$(basename "$(CFG="" resolve_project "$ONLY_PROJECT" 2>/dev/null)" .json 2>/dev/null)
    [ -n "$only_canon" ] || only_canon="$ONLY_PROJECT"
  fi
  # ── primary targets on the owning project ──────────────────────────
  if [ -z "$only_canon" ] || [ "$only_canon" = "$owning" ]; then
    cfg_arr ".secrets[\"$key\"].targets" | while IFS= read -r t; do
      [ -n "$t" ] || continue
      _target_allowed "$t" || { echo "  ⏭  skip $t (filtered by --targets)" >&2; continue; }
      _dispatch_target "$t" "$key" "$value"
    done
  else
    echo "  ⏭  skip $owning primary targets (--only-project $only_canon)" >&2
  fi
  # --only-project naming the owning project means cross-prop is not wanted.
  [ -n "$only_canon" ] && [ "$only_canon" = "$owning" ] && return 0

  # ── crossProjectPropagate: same value lands in other projects too ──
  # Used when a secret has to be the SAME value across services (e.g. a JWT
  # signing key issued by an auth server and verified by N other services
  # with HS256). Each entry temporarily switches CFG context to the named
  # project's config and reruns the listed target subset there. The other
  # project's gcpProject / vercel / cloudRun / localEnv blocks supply the
  # destination metadata. By default the destination env var name is the same
  # key; entry.key may override it for projects that use a legacy name.
  # --targets filters WITHIN cross-prop (each downstream entry's target list is
  # intersected with the filter below), rather than skipping cross-prop. So
  # `--targets koyeb` reaches every koyeb sink wherever it lives — including a
  # downstream-only sink like VocabCompanion's — and `--targets ssh` retries ssh
  # across primary AND downstream after a partial failure.
  local cp_json; cp_json=$(jq -c --arg k "$key" '.secrets[$k].crossProjectPropagate // []' "$CFG")
  local cp_len; cp_len=$(echo "$cp_json" | jq -r 'length')
  if [ "$cp_len" -gt 0 ]; then
    local saved_cfg="$CFG"
    local i=0
    while [ "$i" -lt "$cp_len" ]; do
      local entry proj dest_key other_cfg target_list t2
      entry=$(echo "$cp_json" | jq -c ".[$i]")
      proj=$(echo "$entry" | jq -r '.project')
      dest_key=$(echo "$entry" | jq -r '.key // empty')
      [ -n "$dest_key" ] || dest_key="$key"
      # --only-project: skip every downstream entry except the named one.
      if [ -n "$only_canon" ] && [ "$proj" != "$only_canon" ]; then i=$((i+1)); continue; fi
      target_list=$(echo "$entry" | jq -r '.targets[]?')
      other_cfg=$(CFG="" resolve_project "$proj") || {
        echo "  ❌ crossProjectPropagate: can't resolve project '$proj'" >&2
        i=$((i+1)); continue
      }
      if [ "$dest_key" = "$key" ]; then
        echo "  ↬ crossProjectPropagate → $proj" >&2
      else
        echo "  ↬ crossProjectPropagate → $proj as $dest_key" >&2
      fi
      CFG="$other_cfg"
      for t2 in $target_list; do
        _target_allowed "$t2" || { echo "  ⏭  skip $t2 on $proj (filtered by --targets)" >&2; continue; }
        _dispatch_target "$t2" "$dest_key" "$value"
      done
      i=$((i+1))
    done
    CFG="$saved_cfg"
  fi
}

# ────────────────────────── subcommands ──────────────────────────

cmd_ls() {
  local alias_file="$CONFIG_DIR/_aliases.json"
  echo "Projects (run with: secret <cmd> <name>)"
  echo
  local f n aliases nsec targets
  for f in "$CONFIG_DIR"/*.json; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .json)
    [ "$n" = "_aliases" ] && continue
    # aliases pointing to this canonical name, joined "a, b"
    if [ -f "$alias_file" ]; then
      aliases=$(jq -r --arg n "$n" \
        'to_entries | map(select(.value==$n) | .key) | join(", ")' "$alias_file")
    else
      aliases=""
    fi
    nsec=$(jq -r '.secrets | length' "$f")
    # union of all primary and cross-project targets across secrets.
    targets=$(jq -r '
      [.secrets[] | (.targets[]?, .crossProjectPropagate[]?.targets[]?)] | unique
      | map(
          if   . == "gcpSecretManager" then "gcpSM"
          elif . == "cloudRun"         then "cloudRun"
          elif . == "vercel"           then "vercel"
          elif . == "koyeb"            then "koyeb"
          elif . == "github"           then "github"
          elif . == "userPassword"     then "userPwd"
          elif . == "ssh"              then "ssh"
          elif . == "localEnv"         then "localEnv"
          else . end
        )
      | sort_by(
          { "gcpSM":0, "cloudRun":1, "vercel":2, "koyeb":3, "github":4, "userPwd":5, "ssh":6, "localEnv":7 }[.]  // 9
        )
      | join(",")' "$f")
    local alias_disp="[$aliases]"
    printf "  %-18s %-14s  %2d secrets  → %s\n" \
      "$n" "$alias_disp" "$nsec" "$targets"
  done
  echo
  echo "Subcommands: list <p> | rotate <p> <KEY> | set <p> <KEY> [--value V|--from-stdin] | pull <p> [KEY]"
}

cmd_list() {
  CFG=$(resolve_project "$1") || exit 1
  echo "Project: $(basename "$CFG" .json)"
  echo "Config:  $CFG"
  echo
  jq -r '
    .secrets | to_entries[]
    | (.value.crossProjectPropagate // []) as $cp
    | "  \(.key)\t[\(.value.strategy)]\t→ \(.value.targets | join(","))\t\(if ($cp | length) > 0 then "↬ " + ($cp | map(.project) | join(",")) else "" end)\t\(if (.value.manualSteps // [] | length) > 0 then "📝" else "" end)"
  ' "$CFG" | column -t -s$'\t'
  local _has_cp _has_steps
  _has_cp=$(jq -e '.secrets | to_entries[] | select((.value.crossProjectPropagate // [] | length) > 0)' "$CFG" 2>/dev/null || true)
  _has_steps=$(jq -e '.secrets | to_entries[] | select((.value.manualSteps // [] | length) > 0)' "$CFG" 2>/dev/null || true)
  if [ -n "$_has_cp" ] || [ -n "$_has_steps" ]; then
    echo
    [ -n "$_has_cp" ]    && echo "↬  = value also propagated to other projects via crossProjectPropagate"
    [ -n "$_has_steps" ] && echo "📝 = has rotation playbook. Show with: secret notes $(basename "$CFG" .json) <KEY>"
  fi
}

# Rotate one key under the currently-resolved CFG. Returns 1 on failure
# (caller decides whether to continue with remaining keys or abort).
_rotate_one_key() {
  local key="$1"
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; return 1; }

  local value=""
  case "$strategy" in
    atlas-mongodb)
      value=$(gen_atlas_mongodb "$key") ;;
    random)
      local length encoding
      length=$(cfg ".secrets[\"$key\"].length");   length="${length:-48}"
      encoding=$(cfg ".secrets[\"$key\"].encoding"); encoding="${encoding:-base62}"
      value=$(gen_random "$length" "$encoding")
      echo "🔑 generated $length-char $encoding random for $key" >&2 ;;
    manual)
      echo "❌ '$key' is strategy=manual — use 'secret set' instead" >&2; return 1 ;;
    *) echo "❌ unknown strategy '$strategy'" >&2; return 1 ;;
  esac
  [ -n "$value" ] || { echo "❌ no value generated for $key" >&2; return 1; }
  local check_cfg="$CFG"
  propagate_all "$key" "$value"
  _queue_post_rotate_check "$key" "$value" "$check_cfg"
}

cmd_rotate() {
  CFG=$(resolve_project "$1") || exit 1
  shift
  # Optional `--targets <list>` and `--only-project <name>` filters (extract
  # from anywhere in args). --targets keeps only the listed sinks (across
  # primary + cross-prop); --only-project keeps only the named project. Useful
  # for partial-failure recovery (e.g. `--targets ssh` retries just ssh).
  local -a _rotate_remaining=()
  while [ $# -gt 0 ]; do
    if [ "$1" = "--targets" ]; then
      TARGET_FILTER="$2"; shift 2
    elif [ "$1" = "--only-project" ]; then
      ONLY_PROJECT="$2"; shift 2
    else
      _rotate_remaining+=("$1"); shift
    fi
  done
  set -- "${_rotate_remaining[@]}"
  [ $# -ge 1 ] || { echo "❌ need at least one KEY" >&2; exit 1; }

  # Multi-key mode: defer Vercel redeploys until the end of the run, so each
  # affected Vercel project only redeploys once (deduplicated by projectId,
  # including across crossProjectPropagate hops). Single-key invocations keep
  # the original immediate-redeploy behavior — no flag change visible.
  local multi=0
  [ $# -gt 1 ] && multi=1
  [ "$multi" = "1" ] && DEFER_VERCEL_REDEPLOY=1

  local key rc=0
  for key in "$@"; do
    if ! _rotate_one_key "$key"; then
      rc=1
      [ "$multi" = "0" ] && exit 1   # single-key keeps original "exit on fail" semantics
      echo "⚠️  rotate $key failed — continuing with remaining keys" >&2
    fi
  done

  if [ "$multi" = "1" ]; then
    DEFER_VERCEL_REDEPLOY=0
    if [ -n "$_PENDING_VERCEL_REDEPLOYS" ]; then
      echo "🚀 flushing batched Vercel redeploys (deduplicated by projectId)" >&2
      _flush_vercel_redeploys
    fi
  fi

  if [ -n "$_POST_ROTATE_CHECK_ROWS" ]; then
    run_post_rotate_checks "$_POST_ROTATE_CHECK_ROWS" || rc=1
  fi

  TARGET_FILTER=""   # always reset (even on early exit paths above)
  ONLY_PROJECT=""
  _POST_ROTATE_CHECK_ROWS=""
  if [ "$rc" -eq 0 ]; then
    echo "🎉 rotated $*"
  else
    echo "❌ one or more rotations or post-rotation self-checks failed (see above)" >&2
    exit 1
  fi
}

cmd_set() {
  CFG=$(resolve_project "$1") || exit 1
  shift
  # Optional `--targets <list>` filter (extract from anywhere in args).
  # See cmd_rotate for semantics.
  local -a _set_remaining=()
  while [ $# -gt 0 ]; do
    if [ "$1" = "--targets" ]; then
      TARGET_FILTER="$2"; shift 2
    elif [ "$1" = "--only-project" ]; then
      ONLY_PROJECT="$2"; shift 2
    else
      _set_remaining+=("$1"); shift
    fi
  done
  set -- "${_set_remaining[@]}"
  [ $# -ge 1 ] || { echo "❌ need at least one KEY" >&2; exit 1; }

  # Collect (key, value) pairs from positional args. Three pair forms,
  # mixable freely in one invocation:
  #   KEY=value                       shorthand (split on FIRST '=')
  #   KEY --value V                   explicit
  #   KEY --from-stdin                stdin (single-key only — can't split)
  #   KEY                             interactive prompt (single-key only)
  local keys=() values=()
  while [ $# -gt 0 ]; do
    local key="" val=""

    # Shorthand: any arg containing '=' (and not starting with one) is treated
    # as KEY=VALUE. Split on first '=' so values can contain '=' (e.g.
    # base64 padding, query strings).
    case "$1" in
      =*)
        echo "❌ '$1' starts with '=' — missing KEY" >&2; exit 1 ;;
      *=*)
        key="${1%%=*}"; val="${1#*=}"
        shift
        ;;
      *)
        key="$1"; shift
        ;;
    esac

    local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
    [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; exit 1; }

    # If shorthand already gave us a value, skip the --value/--from-stdin parse.
    if [ -z "$val" ]; then
      if [ $# -eq 0 ]; then
        # No more args — only OK if this is the ONLY key (interactive prompt path)
        if [ ${#keys[@]} -gt 0 ]; then
          echo "❌ missing value source for '$key' (use KEY=V, --value V, or --from-stdin)" >&2; exit 1
        fi
        printf "Value for %s: " "$key" >&2
        stty -echo 2>/dev/null; IFS= read -r val; stty echo 2>/dev/null; echo >&2
      else
        case "$1" in
          --value)
            val="$2"; shift 2 ;;
          --from-stdin)
            # stdin can't be split between keys; only allowed for single-key invocation
            if [ ${#keys[@]} -gt 0 ] || [ $# -gt 1 ]; then
              echo "❌ --from-stdin only supported for single-key invocations" >&2; exit 1
            fi
            val="$(cat)"; shift ;;
          *)
            echo "❌ expected '=value', --value, or --from-stdin after key '$key', got '$1'" >&2; exit 1 ;;
        esac
      fi
    fi
    [ -n "$val" ] || { echo "❌ empty value for '$key'" >&2; exit 1; }

    keys+=("$key")
    values+=("$val")
  done

  # Multi-key mode: defer Vercel redeploys, same as cmd_rotate.
  local multi=0
  [ ${#keys[@]} -gt 1 ] && multi=1
  [ "$multi" = "1" ] && DEFER_VERCEL_REDEPLOY=1

  local i
  for i in "${!keys[@]}"; do
    local check_cfg="$CFG"
    propagate_all "${keys[$i]}" "${values[$i]}"
    _queue_post_rotate_check "${keys[$i]}" "${values[$i]}" "$check_cfg"
  done

  if [ "$multi" = "1" ]; then
    DEFER_VERCEL_REDEPLOY=0
    if [ -n "$_PENDING_VERCEL_REDEPLOYS" ]; then
      echo "🚀 flushing batched Vercel redeploys (deduplicated by projectId)" >&2
      _flush_vercel_redeploys
    fi
  fi

  local rc=0
  if [ -n "$_POST_ROTATE_CHECK_ROWS" ]; then
    run_post_rotate_checks "$_POST_ROTATE_CHECK_ROWS" || rc=1
  fi

  TARGET_FILTER=""   # always reset
  ONLY_PROJECT=""
  _POST_ROTATE_CHECK_ROWS=""
  if [ "$rc" -eq 0 ]; then
    echo "🎉 set ${keys[*]}"
  else
    echo "❌ post-rotation self-check failed (see above)" >&2
    exit 1
  fi
}

# Read the current value of $key for the resolved CFG. Tries sources in
# decreasing reliability:
#   1. localEnv file (cheapest, no API)
#   2. GCP Secret Manager (latest version)
#   3. Vercel single-env endpoint with decrypt=true (works for plain/encrypted,
#      NOT sensitive)
# Used by add/remove to know existing list values before mutating them.
_read_current_value() {
  local key="$1"
  local got=""

  # ── 1. localEnv ─────────────────────────────────────────────────────
  # Mirrors prop_local_env: per-secret localEnv[0] overrides top-level, and
  # the env-var name on disk can be a renamed `.key` (e.g. MONGODB_URI in
  # config writes as MONGODB_URL in docker/.env). Grep for the resolved
  # name, not the config-side $key.
  local root env_file env_key
  root=$(cfg_root)
  if [ -n "$root" ]; then
    env_file=$(jq -r --arg k "$key" '.secrets[$k].localEnv[0].file // empty' "$CFG")
    env_key=$(jq -r  --arg k "$key" '.secrets[$k].localEnv[0].key  // empty' "$CFG")
    if [ -z "$env_file" ]; then
      env_file=$(jq -r '.localEnv[0].file // empty' "$CFG")
      env_key=$(jq -r  '.localEnv[0].key  // empty' "$CFG")
    fi
    [ -z "$env_key" ] && env_key="$key"
    if [ -n "$env_file" ] && [ -f "$root/$env_file" ]; then
      got=$(grep -E "^${env_key}=" "$root/$env_file" | head -1 | cut -d= -f2-)
      if [ -n "$got" ]; then printf '%s' "$got"; return 0; fi
    fi
  fi

  # ── 2. GCP Secret Manager ──────────────────────────────────────────
  local proj acct name
  proj=$(cfg .gcpProject)
  if [ -n "$proj" ]; then
    local has_target
    has_target=$(jq -r --arg k "$key" '.secrets[$k].targets | index("gcpSecretManager") // empty' "$CFG")
    if [ -n "$has_target" ]; then
      acct=$(cfg .gcpAccount)
      name=$(gcp_secret_name "$key")
      local gargs="--project $proj"
      [ -n "$acct" ] && gargs="$gargs --account $acct"
      got=$($GCLOUD secrets versions access latest --secret "$name" $gargs 2>/dev/null || true)
      if [ -n "$got" ]; then printf '%s' "$got"; return 0; fi
    fi
  fi

  # ── 3. Vercel single-env endpoint ──────────────────────────────────
  local pid org
  pid=$(cfg '.vercel.projectId')
  if [ -n "$pid" ]; then
    org=$(cfg '.vercel.orgId')
    local token
    token=$(security find-generic-password -s vercel-api -a token -w 2>/dev/null || true)
    [ -z "$token" ] && token="${VERCEL_TOKEN:-}"
    if [ -n "$token" ]; then
      local team_qs=""; [ -n "$org" ] && team_qs="?teamId=$org"
      local list; list=$(curl -sS -H "Authorization: Bearer $token" \
        "https://api.vercel.com/v10/projects/$pid/env$team_qs")
      # 2>/dev/null: a 4xx response (bad project id, no team access) returns
      # {error:{…}} instead of {envs:[…]} — jq complains; we just want empty.
      local env_id; env_id=$(echo "$list" | jq -r --arg k "$key" \
        '.envs[]? | select(.key==$k) | .id' 2>/dev/null | head -1)
      local env_type; env_type=$(echo "$list" | jq -r --arg k "$key" \
        '.envs[]? | select(.key==$k) | .type' 2>/dev/null | head -1)
      if [ -n "$env_id" ] && [ "$env_type" != "sensitive" ]; then
        local one_url
        if [ -n "$org" ]; then
          one_url="https://api.vercel.com/v1/projects/$pid/env/$env_id?teamId=$org&decrypt=true"
        else
          one_url="https://api.vercel.com/v1/projects/$pid/env/$env_id?decrypt=true"
        fi
        local single; single=$(curl -sS -H "Authorization: Bearer $token" "$one_url")
        local decrypted; decrypted=$(echo "$single" | jq -r '.decrypted // false')
        if [ "$decrypted" = "true" ]; then
          got=$(echo "$single" | jq -r '.value')
          if [ -n "$got" ]; then
            echo "  ℹ️  read current value from Vercel (encrypted env, decrypted via single-env endpoint)" >&2
            printf '%s' "$got"; return 0
          fi
        elif [ "$env_type" = "sensitive" ]; then
          echo "  ⚠️  $key is type=sensitive on Vercel — value is write-only and can't be auto-read" >&2
        fi
      fi
    fi
  fi

  echo "❌ couldn't read current value of $key from any source (localEnv/gcpSM/vercel). Run \`secret set\` once to bootstrap." >&2
  return 1
}

cmd_add() {
  CFG=$(resolve_project "$1") || exit 1
  local key="$2"; shift 2
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; exit 1; }
  local new_item="" sep=","
  while [ $# -gt 0 ]; do
    case "$1" in
      --value)     new_item="$2"; shift 2 ;;
      --separator) sep="$2"; shift 2 ;;
      *) echo "❌ unknown arg '$1'" >&2; exit 1 ;;
    esac
  done
  [ -n "$new_item" ] || { echo "❌ --value required" >&2; exit 1; }

  local current; current=$(_read_current_value "$key") || exit 1

  # Dedupe: bail early if new_item already present.
  local IFS_save="$IFS"
  IFS="$sep"
  local found=0 item
  for item in $current; do
    [ "$item" = "$new_item" ] && { found=1; break; }
  done
  IFS="$IFS_save"
  if [ "$found" = "1" ]; then
    echo "✅ '$new_item' already in $key — no-op"
    return 0
  fi

  local new_value
  if [ -z "$current" ]; then new_value="$new_item"
  else new_value="${current}${sep}${new_item}"
  fi
  echo "🔧 $key: appending '$new_item' (separator='$sep')" >&2
  propagate_all "$key" "$new_value"
  echo "🎉 added '$new_item' to $key"
}

cmd_remove() {
  CFG=$(resolve_project "$1") || exit 1
  local key="$2"; shift 2
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG")" >&2; exit 1; }
  local drop_item="" sep=","
  while [ $# -gt 0 ]; do
    case "$1" in
      --value)     drop_item="$2"; shift 2 ;;
      --separator) sep="$2"; shift 2 ;;
      *) echo "❌ unknown arg '$1'" >&2; exit 1 ;;
    esac
  done
  [ -n "$drop_item" ] || { echo "❌ --value required" >&2; exit 1; }

  local current; current=$(_read_current_value "$key") || exit 1

  local IFS_save="$IFS"
  IFS="$sep"
  local kept="" found=0 item
  for item in $current; do
    if [ "$item" = "$drop_item" ]; then
      found=1
    else
      kept="${kept:+${kept}${sep}}${item}"
    fi
  done
  IFS="$IFS_save"
  if [ "$found" = "0" ]; then
    echo "✅ '$drop_item' not in $key — no-op"
    return 0
  fi
  echo "🔧 $key: removing '$drop_item' (separator='$sep')" >&2
  propagate_all "$key" "$kept"
  echo "🎉 removed '$drop_item' from $key"
}

_looks_secretly_named() {
  # Heuristic: returns 0 (true) when KEY name suggests a credential.
  local k="$1"
  case "$k" in
    MONGODB_URI|MONGO_URI|DATABASE_URL) return 0 ;;
    *_SECRET|SECRET_*|*_SECRET_*) return 0 ;;
    *_TOKEN|*_TOKEN_*) return 0 ;;
    *_PASSWORD|*_PASSWORD_*) return 0 ;;
    *_PRIVATE_KEY|*_PRIVATE) return 0 ;;
    *_API_KEY|*_API_SECRET) return 0 ;;
    *_CREDENTIALS|*_CREDENTIALS_*|*_CREDS) return 0 ;;
    *_KEY) return 0 ;;
  esac
  return 1
}

_vercel_upgrade_one() {
  # Requires CFG set. Args: dry(0|1), target_type(sensitive|encrypted), all_keys(0|1)
  # If $SECRET_SUMMARY_FILE is set, appends "name|up|skip|fail" for the wrapper.
  local dry="$1" target_type="$2" all_keys="${3:-0}"
  local _proj_name; _proj_name=$(basename "$CFG" .json)
  local _n_up=0 _n_sk=0 _n_fail=0
  local pid org token
  pid=$(cfg '.vercel.projectId'); [ -n "$pid" ] || { echo "❌ no vercel.projectId in $(basename "$CFG")" >&2; exit 1; }
  org=$(cfg '.vercel.orgId')
  token=$(security find-generic-password -s vercel-api -a token -w 2>/dev/null || true)
  [ -n "$token" ] || token="${VERCEL_TOKEN:-}"
  [ -n "$token" ] || { echo "❌ need vercel token in keychain 'vercel-api' (or \$VERCEL_TOKEN)" >&2; exit 1; }

  local team_arg=""; [ -n "$org" ] && team_arg="teamId=$org&"
  local tmp; tmp="$(mktemp)"
  curl -sS -H "Authorization: Bearer $token" \
    "https://api.vercel.com/v10/projects/$pid/env?${team_arg}decrypt=true" >"$tmp"

  local total plain enc
  total=$(jq -r '.envs | length' "$tmp")
  plain=$(jq -r '[.envs[] | select(.type=="plain")] | length' "$tmp")
  enc=$(jq -r '[.envs[] | select(.type=="encrypted")] | length' "$tmp")
  local heuristic_msg=""
  [ "$all_keys" = "0" ] && heuristic_msg=" (heuristic — *_SECRET/_TOKEN/_KEY/_PASSWORD/_PRIVATE/_CREDENTIALS/MONGODB_URI…)"
  echo "Project $(basename "$CFG" .json): $total env vars  ($plain plain, $enc encrypted, target=$target_type)$heuristic_msg"
  if [ "$plain" = "0" ] && { [ "$target_type" = "encrypted" ] || [ "$enc" = "0" ]; }; then
    rm -f "$tmp"; echo "✅ nothing to do"; return 0
  fi

  if [ "$dry" = "1" ]; then
    echo "── dry-run ──"
    # Build a unified, key-deduped list: per key, union of types + union of targets.
    local agg
    agg=$(jq -c '
      [.envs[] | select(.type=="plain" or .type=="encrypted") | {key, type, target}]
      | group_by(.key)
      | map({
          key:     .[0].key,
          types:   ([.[].type] | unique),
          targets: ([.[].target[]] | unique)
        })
      | sort_by(.key)
    ' "$tmp")

    local upgrade_list="" skip_list=""
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      local k tgts types
      k=$(echo "$row"     | jq -r '.key')
      tgts=$(echo "$row"  | jq -r '.targets | join(",")')
      types=$(echo "$row" | jq -r '.types | join("+")')
      if [ "$all_keys" = "1" ] || _looks_secretly_named "$k"; then
        upgrade_list+=$(printf '    ✓ %-40s  %-12s  targets=%s\n' "$k" "[$types]" "$tgts")$'\n'
      else
        skip_list+=$(printf '    ↷ %-40s  %-12s  targets=%s\n' "$k" "[$types]" "$tgts")$'\n'
      fi
    done < <(echo "$agg" | jq -c '.[]')

    local n_up n_sk
    n_up=$(printf '%s' "$upgrade_list" | grep -c . || true)
    n_sk=$(printf '%s' "$skip_list"    | grep -c . || true)
    _n_up="$n_up"; _n_sk="$n_sk"

    if [ "$n_up" -gt 0 ]; then
      echo
      echo "  ✓ will upgrade ($n_up keys) → $target_type:"
      printf '%s' "$upgrade_list"
    fi
    if [ "$n_sk" -gt 0 ]; then
      echo
      echo "  ↷ will skip ($n_sk keys) — name doesn't look credential-shaped:"
      printf '%s' "$skip_list"
    fi
    [ "$n_up" = 0 ] && [ "$n_sk" = 0 ] && echo "  (nothing in scope)"
    rm -f "$tmp"
    [ -n "${SECRET_SUMMARY_FILE:-}" ] && \
      echo "$_proj_name|$_n_up|$_n_sk|0" >> "$SECRET_SUMMARY_FILE"
    return 0
  fi

  local _tally; _tally=$(mktemp)

  # Path A: plain → target_type (need to read+rewrite value)
  if [ "$plain" != "0" ]; then
    echo "── plain → $target_type (delete + recreate) ──"
    jq -c '.envs[] | select(.type=="plain")' "$tmp" | while IFS= read -r entry; do
      local id key value targets_json
      id=$(echo "$entry"      | jq -r '.id')
      key=$(echo "$entry"     | jq -r '.key')
      value=$(echo "$entry"   | jq -r '.value')
      targets_json=$(echo "$entry" | jq -c '.target')
      if [ "$all_keys" = "0" ] && ! _looks_secretly_named "$key"; then
        echo "  ↷ $key  (skip — not credential-shaped)"
        echo sk >> "$_tally"
        continue
      fi
      # If target=sensitive, strip 'development'
      if [ "$target_type" = "sensitive" ]; then
        targets_json=$(echo "$targets_json" | jq -c 'map(select(. != "development"))')
        [ "$(echo "$targets_json" | jq 'length')" -gt 0 ] || {
          echo "  ⚠️  $key: only targets development — can't be sensitive, skipping"; continue
        }
      fi
      local dcode; dcode=$(curl -sS -o /dev/null -w '%{http_code}' \
        -X DELETE -H "Authorization: Bearer $token" \
        "https://api.vercel.com/v10/projects/$pid/env/$id?${team_arg%&}")
      if ! echo "$dcode" | grep -qE '^20'; then
        echo "  ❌ delete $key HTTP $dcode"; echo fail >> "$_tally"; continue
      fi
      local out; out="$(mktemp)"
      local ccode; ccode=$(curl -sS -o "$out" -w '%{http_code}' \
        -X POST -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        "https://api.vercel.com/v10/projects/$pid/env?${team_arg%&}" \
        -d "$(jq -nc --arg k "$key" --arg v "$value" --arg ty "$target_type" --argjson t "$targets_json" \
                '{key:$k, value:$v, type:$ty, target:$t}')")
      if echo "$ccode" | grep -qE '^20'; then
        echo "  ✅ $key  ($(echo "$targets_json" | jq -r 'join(",")'))"
        echo up >> "$_tally"
      else
        echo "  ❌ create $key HTTP $ccode"; cat "$out"
        echo fail >> "$_tally"
      fi
      rm -f "$out"
    done
  fi

  # Path B: encrypted → sensitive (PATCH in place, value unchanged)
  if [ "$target_type" = "sensitive" ] && [ "$enc" != "0" ]; then
    echo "── encrypted → sensitive (PATCH, value preserved) ──"
    jq -c '.envs[] | select(.type=="encrypted")' "$tmp" | while IFS= read -r entry; do
      local id key targets_json new_targets
      id=$(echo "$entry"      | jq -r '.id')
      key=$(echo "$entry"     | jq -r '.key')
      targets_json=$(echo "$entry" | jq -c '.target')
      if [ "$all_keys" = "0" ] && ! _looks_secretly_named "$key"; then
        echo "  ↷ $key  (skip — not credential-shaped)"
        echo sk >> "$_tally"
        continue
      fi
      new_targets=$(echo "$targets_json" | jq -c 'map(select(. != "development"))')
      [ "$(echo "$new_targets" | jq 'length')" -gt 0 ] || {
        echo "  ⚠️  $key: only targets development — can't be sensitive, skipping"
        echo sk >> "$_tally"
        continue
      }
      local out; out="$(mktemp)"
      local pcode; pcode=$(curl -sS -o "$out" -w '%{http_code}' \
        -X PATCH -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        "https://api.vercel.com/v10/projects/$pid/env/$id?${team_arg%&}" \
        -d "$(jq -nc --argjson t "$new_targets" '{type:"sensitive", target:$t}')")
      if echo "$pcode" | grep -qE '^20'; then
        local dropped=""; [ "$targets_json" != "$new_targets" ] && dropped="  (dropped development)"
        echo "  ✅ $key$dropped"
        echo up >> "$_tally"
      else
        echo "  ❌ PATCH $key HTTP $pcode"; cat "$out"
        echo fail >> "$_tally"
      fi
      rm -f "$out"
    done
  fi

  _n_up=$(grep -c '^up$'   "$_tally" 2>/dev/null || echo 0)
  _n_sk=$(grep -c '^sk$'   "$_tally" 2>/dev/null || echo 0)
  _n_fail=$(grep -c '^fail$' "$_tally" 2>/dev/null || echo 0)
  rm -f "$_tally" "$tmp"
  [ -n "${SECRET_SUMMARY_FILE:-}" ] && \
    echo "$_proj_name|$_n_up|$_n_sk|$_n_fail" >> "$SECRET_SUMMARY_FILE"
  echo "🎉 done  ($_n_up upgraded, $_n_sk skipped, $_n_fail failed)"
}

cmd_vercel_upgrade() {
  local dry=0 target_type="sensitive" all=0 all_keys=0 proj=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)   dry=1; shift ;;
      --encrypted) target_type="encrypted"; shift ;;
      --sensitive) target_type="sensitive"; shift ;;
      --all)       all=1; shift ;;
      --all-keys)  all_keys=1; shift ;;
      -*) echo "❌ unknown arg $1" >&2; exit 1 ;;
      *)  [ -z "$proj" ] && proj="$1" || { echo "❌ multiple projects given" >&2; exit 1; }; shift ;;
    esac
  done

  if [ "$all" = "1" ]; then
    [ -z "$proj" ] || { echo "❌ --all takes no project arg" >&2; exit 1; }
    local f n first=1
    local summary_file; summary_file=$(mktemp)
    export SECRET_SUMMARY_FILE="$summary_file"
    for f in "$CONFIG_DIR"/*.json; do
      [ -f "$f" ] || continue
      n=$(basename "$f" .json)
      [ "$n" = "_aliases" ] && continue
      [ -n "$(jq -r '.vercel.projectId // empty' "$f")" ] || continue
      [ "$first" = 1 ] || echo
      first=0
      echo "════════ $n ════════"
      CFG="$f"
      _vercel_upgrade_one "$dry" "$target_type" "$all_keys"
    done

    # Grand total
    echo
    echo "════════ TOTAL ════════"
    if [ -s "$summary_file" ]; then
      local up_verb sk_verb
      if [ "$dry" = "1" ]; then
        up_verb="would upgrade"; sk_verb="would skip"
      else
        up_verb="upgraded";      sk_verb="skipped"
      fi
      awk -F'|' -v up_verb="$up_verb" -v sk_verb="$sk_verb" '
        { n++; up+=$2; sk+=$3; fl+=$4 }
        END {
          printf "  %d project%s   %s %d   %s %d",
            n, (n==1?"":"s"), up_verb, up, sk_verb, sk;
          if (fl+0 > 0) printf "   failed %d", fl;
          print ""
        }
      ' "$summary_file"
    else
      echo "  (no projects matched — no vercel block in any config?)"
    fi
    rm -f "$summary_file"
    unset SECRET_SUMMARY_FILE
    return 0
  fi

  [ -n "$proj" ] || { usage; exit 1; }
  CFG=$(resolve_project "$proj") || exit 1
  _vercel_upgrade_one "$dry" "$target_type" "$all_keys"
}

_print_single_notes() {
  # $1 = config path, $2 = secret key
  local cfg_path="$1" key="$2"
  local strategy targets note nsteps
  strategy=$(jq -r --arg k "$key" '.secrets[$k].strategy // empty' "$cfg_path")
  [ -n "$strategy" ] || return 1
  targets=$(jq -r --arg k "$key" '.secrets[$k].targets | join(",")' "$cfg_path")
  note=$(jq -r --arg k "$key" '.secrets[$k]._note // empty' "$cfg_path")
  nsteps=$(jq -r --arg k "$key" '.secrets[$k].manualSteps | length // 0' "$cfg_path")

  echo "── $(basename "$cfg_path" .json) / $key ──"
  echo "strategy: $strategy"
  echo "targets:  $targets"
  if [ -n "$note" ]; then
    echo; echo "Note:"
    printf '  %s\n' "$note"
  fi
  if [ "$nsteps" -gt 0 ]; then
    echo; echo "Rotation steps:"
    jq -r --arg k "$key" '.secrets[$k].manualSteps | to_entries[] | "  \(.key+1). \(.value)"' "$cfg_path"
  fi
}

_keys_with_steps() {
  # $1 = config path → emit each key that has non-empty manualSteps
  jq -r '.secrets | to_entries[] | select((.value.manualSteps // [] | length) > 0) | .key' "$1"
}

cmd_notes() {
  case "$#" in
    2)
      # Single secret in a single project
      CFG=$(resolve_project "$1") || exit 1
      _print_single_notes "$CFG" "$2" \
        || { echo "❌ secret '$2' not in $(basename "$CFG" .json)" >&2; exit 1; }
      ;;
    1)
      # All secrets with manualSteps in this project
      CFG=$(resolve_project "$1") || exit 1
      local keys k first=1
      keys=$(_keys_with_steps "$CFG")
      if [ -z "$keys" ]; then
        echo "(no secrets with manualSteps in $(basename "$CFG" .json))"
        return 0
      fi
      printf '%s\n' "$keys" | while IFS= read -r k; do
        [ -n "$k" ] || continue
        [ "$first" = 1 ] || echo
        first=0
        _print_single_notes "$CFG" "$k"
      done
      ;;
    0)
      # All secrets with manualSteps across all configs
      local f n keys k printed=0
      for f in "$CONFIG_DIR"/*.json; do
        [ -f "$f" ] || continue
        n=$(basename "$f" .json)
        [ "$n" = "_aliases" ] && continue
        keys=$(_keys_with_steps "$f")
        [ -n "$keys" ] || continue
        printf '%s\n' "$keys" | while IFS= read -r k; do
          [ -n "$k" ] || continue
          [ "$printed" = 0 ] || echo
          printed=1
          _print_single_notes "$f" "$k"
        done
        printed=1
      done
      ;;
    *) usage; exit 1 ;;
  esac
}

cmd_get() {
  # Prints the current value of <KEY> for <project> to stdout, using the same
  # multi-source fallback chain as add/remove (localEnv → gcpSM → Vercel
  # single-env decrypt). Intended for human callers — agents should NOT call
  # this without an explicit user request (see managing-secrets skill).
  CFG=$(resolve_project "$1") || exit 1
  local key="$2"
  local strategy; strategy=$(cfg ".secrets[\"$key\"].strategy")
  [ -n "$strategy" ] || { echo "❌ secret '$key' not in $(basename "$CFG" .json)" >&2; exit 1; }

  # Warn loudly if stdout is being captured (pipe / redirection / agent shell).
  if [ ! -t 1 ]; then
    echo "⚠️  secret get: stdout is not a TTY (piped, redirected, or running under an agent). If this value lands in a transcript or log, treat it as compromised and rotate." >&2
  fi

  local value
  value=$(_read_current_value "$key") || exit 1
  [ -n "$value" ] || { echo "❌ no value found for $key in any reachable source (localEnv / gcpSecretManager / Vercel-non-sensitive)" >&2; exit 1; }
  printf '%s\n' "$value"
}

cmd_pull() {
  CFG=$(resolve_project "$1") || exit 1
  local key="${2:-}"
  local proj acct
  proj=$(cfg .gcpProject)
  [ -n "$proj" ] || { echo "❌ pull only works with gcpSecretManager (no gcpProject in config)" >&2; exit 1; }
  acct=$(cfg .gcpAccount)
  local gargs; gargs="--project $proj"
  [ -n "$acct" ] && gargs="$gargs --account $acct"

  local keys
  if [ -n "$key" ]; then keys="$key"
  else keys=$(jq -r '.secrets | keys[]' "$CFG")
  fi
  local k
  for k in $keys; do
    local has; has=$(jq -r --arg k "$k" '.secrets[$k].targets | index("gcpSecretManager") // empty' "$CFG")
    [ -n "$has" ] || { echo "  skip $k (no gcpSecretManager target)"; continue; }
    local name; name=$(gcp_secret_name "$k")
    local v; v=$($GCLOUD secrets versions access latest --secret "$name" $gargs 2>/dev/null) || {
      echo "  ⚠️  $k: read failed"; continue
    }
    prop_local_env "$k" "$v"
  done
}

# ────────────────────────── main ──────────────────────────

[ $# -gt 0 ] || { usage; exit 1; }
sub="$1"; shift
case "$sub" in
  ls)              cmd_ls ;;
  list)            [ $# -ge 1 ] || { usage; exit 1; }; cmd_list "$1" ;;
  rotate)          [ $# -ge 2 ] || { usage; exit 1; }; cmd_rotate "$@" ;;
  set)             [ $# -ge 2 ] || { usage; exit 1; }; cmd_set "$@" ;;
  add)             [ $# -ge 2 ] || { usage; exit 1; }; cmd_add "$@" ;;
  remove)          [ $# -ge 2 ] || { usage; exit 1; }; cmd_remove "$@" ;;
  pull)            [ $# -ge 1 ] || { usage; exit 1; }; cmd_pull "$@" ;;
  get)             [ $# -ge 2 ] || { usage; exit 1; }; cmd_get "$1" "$2" ;;
  notes)           cmd_notes "$@" ;;
  vercel-upgrade)  cmd_vercel_upgrade "$@" ;;
  -h|--help|help) usage ;;
  *) echo "unknown subcommand: $sub" >&2; usage; exit 1 ;;
esac
